<div class="level">
  <div class="level-left">
    <h1 class="title level-item">Sites</h1>
  </div>
</div>

<p class="content">
  A site is a remote WireGuard <em>server</em> this hub dials — a UniFi gateway,
  another VPN, a home UDM. Clients stay on Naaf; Naaf holds the remote session
  and routes the listed networks to that peer. This is not a client: the remote
  side must add a peer whose public key is this box's server key.
</p>

<div class="notification is-light">
  <p>
    On the remote server add a peer with
    <strong>Public key =</strong> <code><%= h(@settings[:server_pubkey]) %></code>.
    Set that peer's <code>AllowedIPs</code> to
    <code><%= h(@settings[:wg_subnet]) %></code>
    (so return traffic can reach Naaf clients). Do
    <strong>not</strong> reuse a laptop's existing client config — that key is a
    different identity.
  </p>
  <p class="mt-2 mb-0">
    Leave <em>Masquerade</em> off unless the remote side will only accept its
    assigned <code>/32</code>. Masquerade hides laptop addresses behind this
    box and stops hosts behind the site from initiating connections back.
  </p>
</div>

<% if @sites.empty? %>
  <div class="notification">No sites. Clients can only reach the VPN subnet and extra routes.</div>
<% else %>
  <% @sites.each do |site| %>
    <% nets = @networks[site[:id]] || [] %>
    <div class="box">
      <div class="level mb-2">
        <div class="level-left">
          <div class="level-item">
            <h2 class="title is-5 mb-0"><%= h(site[:name]) %></h2>
          </div>
          <div class="level-item">
            <% if site[:enabled] %>
              <span class="tag is-success">enabled</span>
            <% else %>
              <span class="tag naaf-chip">disabled</span>
            <% end %>
            <% if site[:masquerade] %>
              <span class="tag is-warning is-light ml-1">masquerade</span>
            <% end %>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <form method="post" action="/sites/<%= site[:id] %>/toggle">
              <%= csrf_tag("/sites/#{site[:id]}/toggle") %>
              <button class="button is-small" type="submit"><%= site[:enabled] ? "Disable" : "Enable" %></button>
            </form>
          </div>
          <div class="level-item">
            <details>
              <summary class="button is-small is-danger is-light">Delete</summary>
              <form method="post" action="/sites/<%= site[:id] %>/delete" class="mt-2">
                <%= csrf_tag("/sites/#{site[:id]}/delete") %>
                <button class="button is-small is-danger" type="submit">Confirm delete</button>
              </form>
            </details>
          </div>
        </div>
      </div>

      <p class="is-size-7 mb-3">
        Endpoint <code><%= h(site[:endpoint]) %></code>
        · keepalive <%= site[:keepalive] %>s
        <% if site[:address] %>
          · address <code><%= h(site[:address]) %></code>
        <% end %>
        · last handshake <%= Naaf::Format.ago(site[:last_handshake_at]) %>
        · <code title="<%= h(site[:pubkey]) %>"><%= h(site[:pubkey][0, 12]) %>…</code>
      </p>

      <% if nets.empty? %>
        <p class="has-text-grey is-size-7">No networks — this peer is not installed until one is added.</p>
      <% else %>
        <table class="table is-fullwidth is-narrow">
          <tbody>
            <% nets.each do |n| %>
              <tr>
                <td><code><%= h(n[:cidr]) %></code></td>
                <td class="has-text-right">
                  <form method="post" action="/sites/<%= site[:id] %>/networks/<%= n[:id] %>/delete">
                    <%= csrf_tag("/sites/#{site[:id]}/networks/#{n[:id]}/delete") %>
                    <button class="button is-small is-danger is-light" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <form method="post" action="/sites/<%= site[:id] %>/networks">
        <%= csrf_tag("/sites/#{site[:id]}/networks") %>
        <div class="field is-grouped">
          <div class="control is-expanded">
            <input class="input is-small" type="text" name="cidr" placeholder="192.168.1.0/24" required>
          </div>
          <div class="control">
            <button class="button is-small" type="submit">Add network</button>
          </div>
        </div>
      </form>
    </div>
  <% end %>
<% end %>

<hr>

<h2 class="title is-5">Add a site</h2>
<form method="post" action="/sites">
  <%= csrf_tag("/sites") %>
  <div class="field is-grouped is-grouped-multiline">
    <div class="control">
      <label class="label">Name</label>
      <input class="input" type="text" name="name" placeholder="unifi" required>
    </div>
    <div class="control is-expanded">
      <label class="label">Remote public key</label>
      <input class="input" type="text" name="pubkey" placeholder="WireGuard public key of the remote server" required autocomplete="off">
    </div>
  </div>
  <div class="field is-grouped is-grouped-multiline">
    <div class="control is-expanded">
      <label class="label">Endpoint host</label>
      <input class="input" type="text" name="endpoint_host" placeholder="unifi.example.com or 203.0.113.9" required>
    </div>
    <div class="control">
      <label class="label">Port</label>
      <input class="input" type="number" name="endpoint_port" value="51820" min="1" max="65535" required>
    </div>
    <div class="control">
      <label class="label">Keepalive</label>
      <input class="input" type="number" name="keepalive" value="25" min="1" max="65535">
    </div>
  </div>
  <div class="field is-grouped is-grouped-multiline">
    <div class="control is-expanded">
      <label class="label">First network</label>
      <input class="input" type="text" name="cidr" placeholder="192.168.1.0/24" required>
    </div>
    <div class="control">
      <label class="label">Assigned address <span class="has-text-grey">(optional)</span></label>
      <input class="input" type="text" name="address" placeholder="192.168.2.2">
    </div>
  </div>
  <div class="field">
    <label class="label">Preshared key <span class="has-text-grey">(optional)</span></label>
    <input class="input" type="text" name="psk" autocomplete="off">
  </div>
  <div class="field">
    <label class="checkbox">
      <input type="checkbox" name="masquerade">
      Masquerade traffic to this site (only if the remote AllowedIPs is the assigned /32)
    </label>
  </div>
  <div class="field">
    <div class="control">
      <button class="button is-primary" type="submit">Add site &amp; apply</button>
    </div>
  </div>
</form>
