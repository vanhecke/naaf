<div class="panel <%= s.udp[:in_errors].to_i.positive? ? "naaf-warn" : "" %>">
  <h2 class="panel-title">Interfaces</h2>

  <% if s.interfaces.empty? %>
    <p class="muted small">
      No interface counters — <code>/proc/net/dev</code> is not readable here.
    </p>
  <% else %>
    <div class="naaf-scroll">
      <table class="table compact">
        <thead>
          <tr>
            <th>Interface</th><th class="num">In</th><th class="num">Out</th>
            <th class="num">In pkt/s</th><th class="num" title="since boot">Errors</th>
            <th class="num">Dropped</th><th title="inbound throughput, recent">Recent</th>
          </tr>
        </thead>
        <tbody>
          <% s.interfaces.each do |i| %>
            <tr>
              <td>
                <code><%= h(i[:name]) %></code>
                <% if i[:role] %>
                  <span class="status status-role"><%= {wan: "wan", wg: "tunnel", exit: "exit"}[i[:role]] %></span>
                <% end %>
              </td>
              <td class="num"><%= fmt.bps(i[:rx_bps]) %></td>
              <td class="num"><%= fmt.bps(i[:tx_bps]) %></td>
              <td class="num"><%= fmt.per_sec(i[:rx_pps], unit: "") %></td>
              <td class="num muted" title="since boot">
                <%= fmt.count(i[:rx_errs].to_i + i[:tx_errs].to_i) %>
              </td>
              <td class="num muted">
                <%= fmt.count(i[:rx_drop].to_i + i[:tx_drop].to_i) %>
              </td>
              <td class="col-spark-sm">
                <%= svg.sparkline(i[:rx_series], height: 20, label: "#{i[:name]} inbound") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <p class="eyebrow">UDP sockets (IPv4, host-wide)</p>
  <div class="strip-group">
    <span class="status">
      delivered <span class="num"><%= fmt.per_sec(s.udp[:in_dps]) %></span>
    </span>
    <%# Rate, not the since-boot total: on a public IP the total is nonzero
        within minutes and a permanently yellow tag teaches people to ignore it. %>
    <span class="status <%= s.udp[:no_ports_ps].to_f.positive? ? "status-warn" : "" %>">
      no port <span class="num"><%= fmt.per_sec(s.udp[:no_ports_ps]) %></span>
    </span>
    <span class="status <%= s.udp[:in_errors].to_i.positive? ? "status-bad" : "" %>">
      errors <span class="num"><%= fmt.count(s.udp[:in_errors]) %></span>
    </span>
    <span class="status">
      buffer overruns <span class="num"><%= fmt.count(s.udp[:rcvbuf_errors]) %></span>
    </span>
  </div>
</div>
