<div class="panel <%= s.app[:reconcile_failing] ? "naaf-alert" : (s.app[:backups_enabled] ? "" : "naaf-warn") %>">
  <h2 class="panel-title">Naaf</h2>

  <table class="table kv compact">
    <tbody>
      <tr>
        <th>Uptime</th>
        <td class="num">
          <%= fmt.duration(s.app[:uptime]) %>
          <span class="muted">· host <%= fmt.duration(s.system[:uptime]) %></span>
        </td>
      </tr>
      <tr>
        <th>Process</th>
        <td class="num">
          <%= fmt.bytes(s.app[:rss]) %> RSS · <%= fmt.pct(s.app[:cpu_pct], places: 1) %> cpu
        </td>
      </tr>
      <tr>
        <th>Ruby</th>
        <td class="num">
          <%= h(s.app[:ruby]) %>
          <% if s.app[:yjit] %><span class="status status-ok">YJIT</span><% end %>
          <span class="muted">· <%= fmt.compact(s.app[:gc_count]) %> GCs</span>
        </td>
      </tr>
      <tr>
        <th>Database</th>
        <td class="num">
          <%= fmt.bytes(s.app[:db_bytes]) %>
          <span class="muted">+ <%= fmt.bytes(s.app[:wal_bytes]) %> WAL</span>
        </td>
      </tr>
      <tr>
        <th>Backup</th>
        <td class="num">
          <% if s.app[:backups_enabled] %>
            <%= fmt.ago(s.app[:backup_at]) %>
            <span class="muted">· <%= fmt.bytes(s.app[:backup_bytes]) %></span>
          <% else %>
            <span class="status status-warn">disabled</span>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Reconcile</th>
        <td class="num">
          <% if s.app[:reconcile_failing] %>
            <span class="status status-bad">failing</span>
            <%# Deliberately no detail: the helper's message can carry key
                material. `journalctl -u naaf` has the whole thing. %>
            <span class="muted">see <code>journalctl -u naaf</code></span>
          <% else %>
            <%= fmt.ago(s.app[:reconcile_at]) %>
            <span class="muted">· applied <%= fmt.ago(s.app[:apply_at]) %></span>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
</div>
