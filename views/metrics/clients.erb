<div class="panel">
  <div class="record-head">
    <h2 class="panel-title">Peers</h2>
    <span class="small">
      <a href="/clients">clients</a>
      ·
      <a href="/sites">sites</a>
    </span>
  </div>

  <% if s.peers.empty? %>
    <p class="muted">No peers yet. Add a <a href="/clients">client</a> or a <a href="/sites">site</a>.</p>
  <% else %>
    <div class="naaf-scroll">
      <%# This table is also the table view for the per-peer sparklines beside
          it — every value in a chart is readable as a number here. %>
      <table class="table">
        <thead>
          <tr>
            <th>Name</th><th>Type</th><th>VPN IP</th><th>Status</th><th>Last handshake</th>
            <th>Endpoint</th>
            <th class="num" title="traffic from the peer to this server">In</th>
            <th class="num" title="traffic from this server to the peer">Out</th>
            <th class="num" title="total both ways since wg0 came up">Total</th>
            <th title="inbound throughput over the last few minutes">Recent</th>
          </tr>
        </thead>
        <tbody>
          <% s.peers.each do |p| %>
            <tr>
              <td><%= h(p[:name]) %></td>
              <td><span class="kind"><%= (p[:kind] == :site) ? "site" : "client" %></span></td>
              <td>
                <% if p[:kind] == :site %>
                  <code class="num"><%= h(fmt.dash(p[:wg_ip])) %></code>
                  <% Array(p[:cidrs]).each do |cidr| %>
                    <code class="num"><%= h(cidr) %></code>
                  <% end %>
                <% else %>
                  <code class="num"><%= h(p[:wg_ip]) %></code>
                <% end %>
              </td>
              <td>
                <%# Disabled first: a site the admin switched off AND left
                    without networks would otherwise report the renderer's
                    reason and hide their own action. %>
                <% if !p[:enabled] %>
                  <span class="status status-disabled">disabled</span>
                <% elsif p[:kind] == :site && Array(p[:cidrs]).empty? %>
                  <span class="status status-warn">not installed — no networks</span>
                <% elsif p[:online] %>
                  <span class="status status-online">online</span>
                <% else %>
                  <span class="status status-idle">idle</span>
                <% end %>
              </td>
              <td class="num"><%= fmt.ago(p[:last_handshake_at]) %></td>
              <td><code class="num"><%= h(fmt.dash(p[:endpoint])) %></code></td>
              <td class="num"><%= fmt.bps(p[:rx_bps]) %></td>
              <td class="num"><%= fmt.bps(p[:tx_bps]) %></td>
              <td class="num muted">
                <%= fmt.bytes(p[:rx_bytes].to_i + p[:tx_bytes].to_i) %>
              </td>
              <td class="col-spark">
                <%= svg.sparkline(p[:rx_series], height: 22,
                                  label: "#{p[:name]} inbound throughput") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
