<div class="box">
  <div class="level mb-2">
    <h2 class="title is-6">Peers</h2>
    <div>
      <a href="/clients">clients</a>
      <a href="/sites">sites</a>
    </div>
  </div>

  <% if s.peers.empty? %>
    <p class="empty">No peers yet. Add a <a href="/clients">client</a> or a <a href="/sites">site</a>.</p>
  <% else %>
    <table class="strips">
      <tbody>
        <% s.peers.each do |p| %>
          <% bare = p[:kind] == :site && Array(p[:cidrs]).empty? %>
          <% state = fmt.peer_state(enabled: p[:enabled], handshake: p[:last_handshake_at], installed: !bare) %>
          <tr class="st-<%= state %>">
            <td>
              <span class="mark" aria-hidden="true"></span>
              <%= Naaf::Format::CODES[state] %>
              <span class="word"><%= Naaf::Format::WORDS[state] %></span>
            </td>
            <td><a class="name" href="<%= (p[:kind] == :site) ? "/sites/#{p[:id]}" : "/clients/#{p[:id]}" %>"><%= h(p[:name]) %></a></td>
            <td><%= (p[:kind] == :site) ? "site" : "client" %></td>
            <td class="mono">
              <% if p[:kind] == :site %>
                <% if Array(p[:cidrs]).empty? %>
                  <span title="not installed — no networks">no networks</span>
                <% else %>
                  <% Array(p[:cidrs]).each do |cidr| %><span><%= h(cidr) %></span> <% end %>
                <% end %>
              <% else %>
                <%= h(p[:wg_ip]) %>
              <% end %>
            </td>
            <td class="mono"><%= fmt.ago(p[:last_handshake_at]) %></td>
            <td class="mono"><%= h(fmt.dash(p[:endpoint])) %></td>
            <td class="num"><%= fmt.bps(p[:rx_bps]) %></td>
            <td class="num"><%= fmt.bps(p[:tx_bps]) %></td>
            <td class="num has-text-grey"><%= fmt.bytes(p[:rx_bytes].to_i + p[:tx_bytes].to_i) %></td>
            <td>
              <%= svg.sparkline(p[:rx_series], height: 22, label: "#{p[:name]} inbound throughput") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
