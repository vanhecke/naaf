<div class="box naaf-tile">
  <h2 class="title is-6">Top talkers</h2>
  <p class="is-size-7 has-text-grey mb-3">
    Per peer, refreshed every reconcile (30s). This box cannot break traffic down
    by external destination — per-flow byte counts need
    <code>/proc/net/nf_conntrack</code> (root-only) or <code>nft</code> counters
    (<code>CAP_NET_ADMIN</code>), and an <code>nft</code> counter would reset on
    every apply.
  </p>

  <% if s.talkers.empty? %>
    <p class="has-text-grey">No throughput measured yet.</p>
  <% else %>
    <table class="table is-fullwidth is-narrow is-hoverable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th class="has-text-right">In</th>
          <th class="has-text-right">Out</th>
          <th>Share</th>
          <th class="has-text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        <% s.talkers.each do |t| %>
          <tr>
            <td><%= h(t[:name]) %></td>
            <td><span class="tag is-light"><%= (t[:kind] == :site) ? "site" : "client" %></span></td>
            <td class="has-text-right naaf-num"><%= fmt.bps(t[:rx_bps]) %></td>
            <td class="has-text-right naaf-num"><%= fmt.bps(t[:tx_bps]) %></td>
            <td>
              <% if t[:share] %>
                <%# The number goes beside the bar, not inside it: <progress>
                    treats its children as fallback for browsers without the
                    element, so the percentage was never rendered at all.
                    The 1% floor is the meter idiom from kpis.erb — a sliver
                    beats a bar pinned at zero — but only above zero. A peer
                    that was measured at 0 B/s while another carried the
                    traffic has a real 0% share, and drawing 1% for it would
                    claim an idle tunnel, which is what the nil handling in
                    Collector#rank_talkers exists to avoid. %>
                <progress class="progress is-small"
                          value="<%= t[:share].positive? ? [t[:share].round, 1].max : 0 %>" max="100"
                          aria-label="share of measured throughput"></progress>
                <span class="is-size-7 has-text-grey naaf-num"><%= fmt.pct(t[:share]) %></span>
              <% else %>
                <%= fmt.dash(t[:share]) %>
              <% end %>
            </td>
            <td class="has-text-right naaf-num has-text-grey">
              <%= fmt.bytes(t[:rx_bytes].to_i + t[:tx_bytes].to_i) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
