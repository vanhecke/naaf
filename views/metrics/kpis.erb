<%# Stat tiles, not charts: each is a label, a value, and a trend beside it.
    The one hero figure on the page is tunnel throughput.

    The hero takes half the width and the four small tiles fill the other half
    as a 2x2. Laying all five out as one row of is-half + 4x is-one-quarter
    overflows into a second row that is only half full, and .naaf-tile stretches
    the survivors to the hero's height around a ragged gap. %>
<div class="columns mb-2">
  <div class="column is-half">
    <div class="box naaf-tile">
      <p class="heading has-text-grey">Tunnel throughput</p>

      <% if s.wg[:rx_bps] || s.wg[:tx_bps] %>
        <%# Two series, ONE axis, mirrored about a shared baseline — never two
            y-scales. Both are direct-labelled here so identity never depends on
            colour alone. %>
        <p class="naaf-hero">
          <span class="has-text-weight-semibold"><%= fmt.bps(s.wg[:rx_bps]) %></span>
          <span class="is-size-6 has-text-grey">in</span>
        </p>
        <p class="is-size-5 mb-2">
          <span class="has-text-weight-semibold"><%= fmt.bps(s.wg[:tx_bps]) %></span>
          <span class="is-size-6 has-text-grey">out</span>
        </p>
        <%= svg.throughput(down: s.wg[:rx_series], up: s.wg[:tx_series], height: 64,
                           label: "tunnel throughput, in above the line and out below") %>
        <p class="is-size-7 has-text-grey mt-2">
          <%= s.wg[:online] %> of <%= s.wg[:enabled] %> clients up<%=
            s.wg[:sites_total].to_i.positive? ? " · #{s.wg[:sites_online]} of #{s.wg[:sites_enabled]} sites up" : "" %><%=
            s.wg[:interval] ? " · refreshed every #{fmt.duration(s.wg[:interval])}" : "" %>
        </p>
      <% else %>
        <%# Nothing measured yet. Saying "0 B/s" here would claim an idle tunnel;
            saying nothing at all leaves the tile looking broken. %>
        <p class="naaf-hero has-text-grey-light">—</p>
        <p class="is-size-6 has-text-grey mb-2">no throughput measured yet</p>
      <% end %>
    </div>
  </div>

  <div class="column is-half">
    <div class="columns is-multiline is-mobile">
      <div class="column is-half">
        <div class="box naaf-tile">
          <p class="heading has-text-grey">DNS queries</p>
          <p class="naaf-value"><%= fmt.per_sec(s.dns[:qps]) %></p>
          <p class="is-size-7 has-text-grey mb-2"><%= fmt.compact(s.dns[:total]) %> since start</p>
          <%= svg.sparkline(s.dns[:series], height: 34, label: "DNS queries per second") %>
        </div>
      </div>

      <div class="column is-half">
        <div class="box naaf-tile">
          <p class="heading has-text-grey">CPU</p>
          <p class="naaf-value"><%= fmt.pct(s.system[:cpu_pct]) %></p>
          <p class="is-size-7 has-text-grey mb-2">
            load <span class="naaf-num"><%= fmt.dash(s.system[:load1]) %></span><%=
              s.system[:ncpu] ? " / #{s.system[:ncpu]} cores" : "" %>
            <% if s.system[:steal_pct] && s.system[:steal_pct] >= 1 %>
              <span class="tag is-warning">steal <%= fmt.pct(s.system[:steal_pct]) %></span>
            <% end %>
          </p>
          <%= svg.sparkline(s.system[:cpu_series], height: 34, max: 100, label: "CPU busy percent") %>
        </div>
      </div>

      <div class="column is-half">
        <div class="box naaf-tile <%= (s.system[:mem_pct].to_f >= 90) ? "naaf-alert" : ((s.system[:mem_pct].to_f >= 80) ? "naaf-warn" : "") %>">
          <p class="heading has-text-grey">Memory</p>
          <p class="naaf-value"><%= fmt.pct(s.system[:mem_pct]) %></p>
          <p class="is-size-7 has-text-grey mb-2">
            <%= fmt.bytes(s.system[:mem_used]) %> of <%= fmt.bytes(s.system[:mem_total]) %>
          </p>
          <%# A ratio against a fixed limit is a meter, not a chart. Only drawn
              when there is a reading: an empty bar would read "plenty free". %>
          <% if s.system[:mem_pct] %>
            <progress class="progress is-small <%= (s.system[:mem_pct] >= 90) ? "is-danger" : "is-info" %>"
                      value="<%= [s.system[:mem_pct].round, 1].max %>" max="100"
                      aria-label="memory used, percent">
              <%= fmt.pct(s.system[:mem_pct]) %>
            </progress>
          <% end %>
          <% if s.system[:swap_used].to_i.positive? %>
            <p class="is-size-7 has-text-grey">swap <%= fmt.bytes(s.system[:swap_used]) %></p>
          <% end %>
        </div>
      </div>

      <div class="column is-half">
        <div class="box naaf-tile <%= (s.system[:conntrack_pct].to_f >= 80) ? "naaf-warn" : "" %>">
          <%# "conntrack entries", not "connections": every UDP pseudo-flow gets
              an entry, so this is table utilisation rather than a session count. %>
          <p class="heading has-text-grey">Conntrack entries</p>
          <p class="naaf-value naaf-num"><%= fmt.compact(s.system[:conntrack_count]) %></p>
          <p class="is-size-7 has-text-grey mb-2">
            of <%= fmt.compact(s.system[:conntrack_max]) %> · <%= fmt.pct(s.system[:conntrack_pct]) %>
          </p>
          <% if s.system[:conntrack_pct] %>
            <%# A table at 0.5% still gets a sliver: a bar pinned at zero looks
                like a broken element rather than a low number. %>
            <progress class="progress is-small <%= (s.system[:conntrack_pct] >= 80) ? "is-warning" : "is-info" %>"
                      value="<%= [s.system[:conntrack_pct].round, 1].max %>" max="100"
                      aria-label="conntrack table used, percent">
              <%= fmt.pct(s.system[:conntrack_pct]) %>
            </progress>
          <% else %>
            <p class="is-size-7 has-text-grey">counters not readable here</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
