<%# docs/TROUBLESHOOTING.md step 3, as a row instead of a shell session.
    tcpdump sees traffic BEFORE netfilter, so a firewall quietly eating
    WireGuard shows up as a healthy first number and a flat second one. %>
<div class="panel <%= (s.pipeline[:verdict] == :stalled) ? "naaf-alert" : "" %>">
  <div class="record-head">
    <h2 class="panel-title">Packet pipeline</h2>
    <% case s.pipeline[:verdict] %>
    <% when :stalled %>
      <span class="status status-bad">no client connected</span>
    <% when :ok %>
      <span class="status status-ok"><%= s.wg[:online] %> clients connected</span>
    <% when :idle %>
      <span class="status">no clients configured</span>
    <% else %>
      <span class="status">no reading yet</span>
    <% end %>
  </div>

  <div class="pipeline-steps">
    <div>
      <p class="eyebrow"><%= fmt.dash(s.pipeline[:wan]) %> received</p>
      <p class="figure num"><%= fmt.per_sec(s.pipeline[:wan_pps], unit: " pkt/s") %></p>
      <p class="small muted">at the interface, before netfilter</p>
    </div>
    <div class="pipeline-arrow" aria-hidden="true">→</div>
    <div>
      <p class="eyebrow">UDP delivered</p>
      <p class="figure num"><%= fmt.per_sec(s.pipeline[:udp_dps], unit: " dg/s") %></p>
      <p class="small muted">reached a socket</p>
    </div>
    <div class="pipeline-arrow" aria-hidden="true">→</div>
    <div>
      <p class="eyebrow"><%= fmt.dash(s.pipeline[:wg]) %> decrypted</p>
      <p class="figure num"><%= fmt.per_sec(s.pipeline[:wg_pps], unit: " pkt/s") %></p>
      <p class="small muted">out of the tunnel</p>
    </div>
  </div>

  <% if s.pipeline[:message] %>
    <div class="callout callout-bad" role="alert">
      <%= h(s.pipeline[:message]) %>
      See <code>docs/TROUBLESHOOTING.md</code>.
    </div>
  <% end %>
</div>
