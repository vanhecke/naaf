<% if error %>
  <div class="callout callout-bad" role="alert"><%= h(error) %></div>
<% elsif report %>
  <% chip = Naaf::Flow::CHIP[report.verdict] %>
  <% tone = {pass: "status status-ok", fail: "status status-bad", warn: "status status-warn"}[report.verdict] || "status" %>
  <div class="panel <%= {fail: "naaf-alert", warn: "naaf-warn"}[report.verdict] %>">
    <div class="record-head">
      <span class="<%= tone %>"><%= chip %></span>
      <p><%= h(report.summary) %></p>
    </div>

    <%# A step list, not a diagram: the interesting part is which line decided
        it, and a line of nft is text. %>
    <% report.steps.each do |step| %>
      <% mark = {pass: "status status-ok", fail: "status status-bad", warn: "status status-warn",
                 unknown: "status"}[step.verdict] || "kind" %>
      <div class="step">
        <span class="<%= mark %>"><%= step.verdict %></span>
        <div>
          <p class="small"><strong><%= h(step.stage) %></strong></p>
          <p class="small"><%= h(step.detail) %></p>
          <% if step.rule %>
            <pre class="naaf-log"><%= h(step.rule) %></pre>
          <% end %>
          <% if step.fix %>
            <p class="small"><a href="<%= step.fix %>">Change it on <%= step.fix %> →</a></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="small muted">
      This reads the database, not the kernel. It cannot see the remote end of a
      site, the base firewall as loaded, or whether a peer is actually
      handshaking. Use ping and traceroute above for what the kernel really does.
    </p>
  </div>
<% end %>
