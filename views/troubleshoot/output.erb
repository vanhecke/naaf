<% if error %>
  <div class="callout callout-bad" role="alert"><%= h(error) %></div>
<% elsif result %>
  <% if result.unavailable %>
    <div class="callout callout-once">
      <code><%= h(tool) %></code> is not installed on this box — re-run
      <code>./deploy.sh</code>, which installs it.
    </div>
  <% else %>
    <div class="panel <%= "naaf-warn" if result.timed_out %>">
      <div class="record-head">
        <span class="status <%= result.timed_out ? "status-warn" : (result.status&.success? ? "status-ok" : "status-bad") %>">
          <% if result.timed_out %>
            stopped after <%= result.seconds.round %>s
          <% else %>
            exit <%= result.status&.exitstatus %>
          <% end %>
        </span>
        <code class="small"><%= h(result.argv.join(" ")) %></code>
        <span class="small muted"><%= result.seconds.round(1) %>s</span>
      </div>
      <%# Remote text on its way to a browser: scrubbed to UTF-8 and capped in
          Diagnostics, escaped here. There is no download route on purpose --
          copy-paste out of this block is the supported path. %>
      <pre class="naaf-log"><%= h(result.output.empty? ? "(no output)" : result.output) %></pre>
    </div>
  <% end %>
<% end %>
