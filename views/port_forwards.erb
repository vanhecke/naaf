<header class="page-head">
  <h1>Port forwards</h1>
</header>

<p class="lede">
  Inbound DNAT from the public interface to a spoke. A public port is forwarded
  to a client's target port; disabled forwards keep their row but emit no rule.
  Each change regenerates <code>inet naaf</code> and applies it atomically.
</p>

<% if @rows.empty? %>
  <p class="empty">No port forwards.</p>
<% else %>
  <% by_id = @clients.to_h { |c| [c[:id], c] } %>
  <table class="table">
    <thead>
      <tr>
        <th>Public port</th>
        <th>Proto</th>
        <th>Target</th>
        <th>Status</th>
        <th colspan="2"></th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <% c = by_id[row[:client_id]] %>
        <tr>
          <td><code><%= row[:public_port] %></code></td>
          <td><span class="kind"><%= row[:proto] %></span></td>
          <td>
            <%= c ? c[:name] : "—" %>
            <code><%= c ? c[:wg_ip] : "?" %>:<%= row[:target_port] %></code>
          </td>
          <td>
            <% if row[:enabled] %>
              <span class="status status-ok">enabled</span>
            <% else %>
              <span class="status status-disabled">disabled</span>
            <% end %>
          </td>
          <td>
            <% if row[:enabled] %>
              <details class="confirm">
                <summary>Disable</summary>
                <form method="post" action="/port-forwards/<%= row[:id] %>/toggle">
                  <%= csrf_tag("/port-forwards/#{row[:id]}/toggle") %>
                  <button class="btn btn-danger-solid" type="submit">Confirm disable</button>
                </form>
              </details>
            <% else %>
              <form method="post" action="/port-forwards/<%= row[:id] %>/toggle">
                <%= csrf_tag("/port-forwards/#{row[:id]}/toggle") %>
                <button class="btn" type="submit">Enable</button>
              </form>
            <% end %>
          </td>
          <td>
            <details class="confirm">
              <summary>Delete</summary>
              <form method="post" action="/port-forwards/<%= row[:id] %>/delete">
                <%= csrf_tag("/port-forwards/#{row[:id]}/delete") %>
                <button class="btn btn-danger-solid" type="submit">Confirm delete</button>
              </form>
            </details>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<hr class="rule">

<h2 class="section">Add a forward</h2>
<% if @clients.empty? %>
  <p class="callout callout-once">Add a client first.</p>
<% else %>
  <form method="post" action="/port-forwards">
    <%= csrf_tag("/port-forwards") %>
    <div class="fields">
      <label class="field">
        <span class="label">Public port</span>
        <input class="input" type="number" name="public_port" min="1" max="65535" required>
      </label>
      <label class="field">
        <span class="label">Protocol</span>
        <select class="input" name="proto">
          <option value="tcp">tcp</option>
          <option value="udp">udp</option>
        </select>
      </label>
      <label class="field">
        <span class="label">Client</span>
        <select class="input" name="client_id" required>
          <% @clients.each do |c| %>
            <option value="<%= c[:id] %>"><%= c[:name] %> (<%= c[:wg_ip] %>)</option>
          <% end %>
        </select>
      </label>
      <label class="field">
        <span class="label">Target port</span>
        <input class="input" type="number" name="target_port" min="1" max="65535" required>
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Add &amp; apply</button>
  </form>
<% end %>
