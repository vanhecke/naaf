<header class="page-head">
  <h1>Split-tunnel routes</h1>
</header>

<p class="lede">
  Extra subnets folded into a client's <code>AllowedIPs</code> for the
  <code>split</code> and <code>split·nodns</code> configs (the <code>full</code>
  config already routes everything). A <em>global</em> route applies to every
  client; a route bound to a client applies to that client only. The VPN subnet
  itself is always included, so you only list networks <em>behind</em> the tunnel.
  <% if @site_routes.any? %>
    Networks of a <a href="/sites">site</a> are folded into split configs
    automatically and listed below so the split-tunnel set is visible in one place —
    do not add them here as well.
  <% else %>
    Networks of a <a href="/sites">site</a> are folded into split configs
    automatically; add them on the site, not here.
  <% end %>
</p>

<% unless @site_routes.empty? %>
  <h2 class="section">From sites</h2>
  <p class="small muted">
    Managed on the site — these install a hub route and fold into every split
    config. There is nothing to delete here.
  </p>
  <table class="table">
    <thead>
      <tr>
        <th>Scope</th>
        <th>CIDR</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @site_routes.each do |row| %>
        <tr>
          <td>
            <span class="kind">site</span>
            <%= h(row[:name]) %>
            <% unless row[:enabled] %>
              <span class="status status-disabled">disabled</span>
            <% end %>
          </td>
          <td><code><%= h(row[:cidr]) %></code></td>
          <td><a href="/sites">managed on Sites →</a></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @rows.empty? %>
  <p class="empty">
    <% if @site_routes.any? %>
      No extra routes. Split configs already include the VPN subnet and the site networks above.
    <% else %>
      No extra routes. Split configs route only the VPN subnet.
    <% end %>
  </p>
<% else %>
  <% by_id = @clients.to_h { |c| [c[:id], c] } %>
  <table class="table">
    <thead>
      <tr>
        <th>Scope</th>
        <th>CIDR</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <% c = row[:client_id] && by_id[row[:client_id]] %>
        <tr>
          <td>
            <% if row[:client_id].nil? %>
              <span class="kind">global</span>
            <% elsif c %>
              <%= c[:name] %> <code><%= c[:wg_ip] %></code>
            <% else %>
              <span class="status status-warn">client #<%= row[:client_id] %></span>
            <% end %>
          </td>
          <td>
            <code><%= row[:cidr] %></code>
            <% if (site = @redundant[row[:id]]) %>
              <span class="status status-warn">also routed by site <%= h(site[:name]) %></span>
            <% end %>
          </td>
          <td>
            <details class="confirm">
              <summary>Delete</summary>
              <form method="post" action="/extra-routes/<%= row[:id] %>/delete">
                <%= csrf_tag("/extra-routes/#{row[:id]}/delete") %>
                <button class="btn btn-danger-solid" type="submit">Confirm delete</button>
              </form>
            </details>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<hr class="rule">

<h2 class="section">Add a route</h2>
<form method="post" action="/extra-routes">
  <%= csrf_tag("/extra-routes") %>
  <div class="fields">
    <label class="field">
      <span class="label">Scope</span>
      <select class="input" name="client_id">
        <option value="">— global (all clients) —</option>
        <% @clients.each do |c| %>
          <option value="<%= c[:id] %>"><%= c[:name] %> (<%= c[:wg_ip] %>)</option>
        <% end %>
      </select>
    </label>
    <label class="field grow">
      <span class="label">CIDR</span>
      <input class="input" type="text" name="cidr" placeholder="192.168.9.0/24" required>
    </label>
  </div>
  <button class="btn btn-primary" type="submit">Add &amp; apply</button>
</form>
