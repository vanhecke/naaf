<% if @wstunnel_unprovisioned %>
  <div class="banner fault">
    <strong>wstunnel is enabled but not provisioned.</strong>
    No path prefix has reached this process, so every <code>split·ws</code> config
    it could hand out would dial a path the server rejects. Run
    <code>./deploy.sh --step 65-wstunnel</code>.
  </div>
<% end %>

<% if session["oneshot_privkey"] %>
  <div class="banner">
    <strong>A private key is waiting.</strong>
    It is not stored. Open
    <a href="/clients/<%= h(session["oneshot_privkey"]["id"]) %>">the new client</a>
    and download or scan before leaving.
  </div>
<% end %>

<div class="page-head">
  <h1>Clients</h1>
  <p class="deck">
    <span class="mono"><%= h(@settings[:wg_subnet]) %></span>
    · gateway <span class="mono"><%= h(@settings[:server_ip]) %></span>
    <% if @proxy %> · SOCKS5 <span class="mono"><%= h(@proxy) %></span><% end %>
  </p>
</div>

<div hx-ext="sse" sse-connect="/events">
  <div id="live-health" sse-swap="health">
    <%= render("metrics/health", locals: {s: snapshot}) %>
  </div>
  <div hx-get="/metrics/health" hx-trigger="every 60s" hx-swap="none"></div>
</div>

<form class="filters" method="get" action="/clients"
      hx-get="/clients" hx-trigger="change, keyup changed delay:300ms from:#q"
      hx-target="#roster" hx-select="#roster" hx-swap="outerHTML" hx-push-url="true">
  <div>
    <label for="q">Search</label>
    <input id="q" type="search" name="q" value="<%= h(@q) %>" placeholder="name, host, address, key">
  </div>
  <div>
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="">Any</option>
      <% %w[online stale offline disabled].each do |state| %>
        <option value="<%= state %>"<%= " selected" if @status == state %>><%= state %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label for="sort">Sort</label>
    <select id="sort" name="sort">
      <% [["", "Address"], ["name", "Name"], ["handshake", "Handshake"]].each do |value, label| %>
        <option value="<%= value %>"<%= " selected" if @sort == value %>><%= label %></option>
      <% end %>
    </select>
  </div>
  <button type="submit">Filter</button>
  <span class="naaf-busy">updating…</span>
</form>

<div id="roster"<% if @q.empty? && @status.empty? %> hx-get="/clients" hx-trigger="every 30s" hx-select="#roster" hx-target="#roster" hx-swap="outerHTML"<% end %>>
  <% if @clients.empty? %>
    <p class="empty">No clients match. Add one below, or clear the filter.</p>
  <% else %>
    <% @clients.each do |c| %>
      <% state = Naaf::Format.peer_state(enabled: c[:enabled], handshake: c[:last_handshake_at]) %>
      <article class="strip st-<%= state %>">
        <div class="badge">
          <span class="mark" aria-hidden="true"></span>
          <span><%= Naaf::Format::CODES[state] %></span>
          <span class="word"><%= Naaf::Format::WORDS[state] %></span>
        </div>
        <div class="cell">
          <a class="name" href="/clients/<%= c[:id] %>"><%= h(c[:name]) %></a>
          <span class="mono"><%= h(c[:hostname]) %>.<%= h(@settings[:dns_domain]) %></span>
        </div>
        <div class="cell"><span class="k">Address</span><span class="mono"><%= h(c[:wg_ip]) %></span></div>
        <div class="cell"><span class="k">Handshake</span><span class="mono"><%= Naaf::Format.ago(c[:last_handshake_at]) %></span></div>
        <div class="cell"><span class="k">Public key</span><span class="mono" title="<%= h(c[:pubkey]) %>"><%= h(c[:pubkey].to_s[0, 12]) %>…</span></div>
        <div class="cell">
          <span class="k">Config</span>
          <div class="buttons are-small has-addons">
            <% @flavors.each do |f| %>
              <% label = {"split-nodns" => "split·nodns", "split-ws" => "split·ws", "split-ws-nodns" => "split·ws·nodns"}.fetch(f, f) %>
              <a class="button" href="/clients/<%= c[:id] %>/config/<%= f %>"><%= h(label) %></a>
            <% end %>
            <a class="button is-link is-light" href="/clients/<%= c[:id] %>/qr/split" target="_blank" rel="noopener">QR</a>
          </div>
          <form method="post" action="/clients/<%= c[:id] %>/toggle">
            <%= csrf_tag("/clients/#{c[:id]}/toggle") %>
            <button class="btn-quiet" type="submit"><%= c[:enabled] ? "Disable" : "Enable" %></button>
          </form>
          <details class="confirm">
            <summary class="btn-danger">Delete</summary>
            <form method="post" action="/clients/<%= c[:id] %>/delete">
              <%= csrf_tag("/clients/#{c[:id]}/delete") %>
              <button class="btn-danger" type="submit">Confirm delete <%= h(c[:name]) %></button>
            </form>
          </details>
        </div>
      </article>
    <% end %>
  <% end %>
</div>

<section class="sheet">
  <h2>Add client</h2>
  <p class="muted">Leave the public key blank to generate one. The private key is shown once on the next page, in the download and the QR, and is not stored.</p>
  <form method="post" action="/clients">
    <%= csrf_tag("/clients") %>
    <div class="row">
      <div>
        <label for="name">Name</label>
        <input id="name" type="text" name="name" placeholder="laptop" required>
      </div>
      <div>
        <label for="hostname">Hostname</label>
        <input id="hostname" type="text" name="hostname" placeholder="laptop" required>
      </div>
      <div style="flex:1">
        <label for="pubkey">Public key <span class="muted">optional</span></label>
        <input id="pubkey" type="text" name="pubkey" placeholder="blank generates a key on the server" autocomplete="off" style="width:100%">
      </div>
    </div>
    <button class="btn-primary" type="submit">Add client and apply</button>
  </form>
</section>
