<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Naaf — WireGuard control plane</title>
  <link rel="stylesheet" href="/naaf.css">
  <%# Core first, extension second, both deferred. Never async: that discards
      ordering and the extension would run before htmx.defineExtension exists. %>
  <script src="/htmx.min.js" defer></script>
  <script src="/htmx-ext-sse.min.js" defer></script>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <% if session["admin"] %>
    <% nav = [
         ["/", "Dashboard"],
         ["/clients", "Clients"],
         ["/exposed-ports", "Exposed ports"],
         ["/port-forwards", "Port forwards"],
         ["/sites", "Sites"],
         ["/exit", "Internet exit"],
         ["/extra-routes", "Routes"],
         ["/dns-records", "DNS"],
         ["/troubleshoot", "Troubleshoot"],
         ["/settings", "Settings"]
       ] %>
    <div class="shell">
      <nav class="rail" aria-label="Sections">
        <a class="brand" href="/">Naaf<small>control plane</small></a>
        <div class="rail-links">
          <% nav.each do |href, label| %>
            <a href="<%= href %>"<% if request.path == href %> aria-current="page"<% end %>><%= label %></a>
          <% end %>
        </div>
        <form class="rail-apply" method="post" action="/apply">
          <%= csrf_tag("/apply") %>
          <button class="btn btn-primary" type="submit">Re-apply state</button>
        </form>
      </nav>
      <div class="workspace">
        <% if flash["error"] %>
          <div class="callout callout-bad" role="alert"><%= flash["error"] %></div>
        <% end %>
        <% if flash["notice"] %>
          <div class="callout callout-ok" role="status"><%= flash["notice"] %></div>
        <% end %>
        <main id="content">
          <%= yield %>
        </main>
      </div>
    </div>
  <% else %>
    <main id="content" class="gate">
      <div class="gate-card">
        <a class="brand" href="/">Naaf<small>control plane</small></a>
        <% if flash["error"] %>
          <div class="callout callout-bad" role="alert"><%= flash["error"] %></div>
        <% end %>
        <% if flash["notice"] %>
          <div class="callout callout-ok" role="status"><%= flash["notice"] %></div>
        <% end %>
        <%= yield %>
      </div>
    </main>
  <% end %>
</body>
</html>
