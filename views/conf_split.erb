<% if socks -%>
# SOCKS5 (per-app on split): <%= socks %>
<% end -%>
[Interface]
PrivateKey = <%= pk %>
Address = <%= client[:wg_ip] %>/32
DNS = <%= s[:server_ip] %>
MTU = <%= mtu %>

[Peer]
PublicKey = <%= s[:server_pubkey] %>
PresharedKey = <%= client[:psk] %>
Endpoint = <%= ep %>
AllowedIPs = <%= allowed %>
PersistentKeepalive = 25
