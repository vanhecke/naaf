<div class="level">
  <div class="level-left">
    <h1 class="title level-item">Exposed ports</h1>
  </div>
</div>

<p class="content">
  Ports a spoke is allowed to accept <em>from other spokes</em>. Everything else
  between spokes is denied (ICMP echo aside). Each change regenerates
  <code>inet naaf</code> and applies it atomically.
</p>

<% if @groups.all? { |g| g[:rows].empty? } && @orphans.empty? %>
  <div class="notification">
    No exposed ports. Spoke-to-spoke traffic is fully denied.
  </div>
<% else %>
  <% @groups.each do |group| %>
    <% c = group[:client] %>
    <% rows = group[:rows] %>
    <div class="box">
      <div class="level mb-2 is-align-items-flex-start">
        <div class="level-left">
          <div class="level-item">
            <h2 class="title is-5 mb-0"><%= h(c[:name]) %></h2>
          </div>
          <div class="level-item">
            <code><%= h(c[:wg_ip]) %></code>
          </div>
          <div class="level-item">
            <span class="tag"><%= rows.size %></span>
          </div>
        </div>
      </div>
      <% if rows.empty? %>
        <p class="has-text-grey">No ports exposed. Other spokes cannot reach this client.</p>
      <% else %>
        <table class="table is-fullwidth is-narrow is-striped is-hoverable">
          <thead>
            <tr>
              <th>Proto</th>
              <th>Port(s)</th>
              <th>Description</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <td><span class="tag"><%= row[:proto] %></span></td>
                <% last = row[:port_end] || row[:port] %>
                <td><code><%= (last == row[:port]) ? row[:port] : "#{row[:port]}-#{last}" %></code></td>
                <td><%= row[:description] %></td>
                <td>
                  <form method="post" action="/exposed-ports/<%= row[:id] %>/delete">
                    <%= csrf_tag("/exposed-ports/#{row[:id]}/delete") %>
                    <button class="button is-small is-danger is-light" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
  <% unless @orphans.empty? %>
    <div class="box naaf-warn">
      <h2 class="title is-5">Orphaned ports</h2>
      <p class="content">These rows have no matching client. The foreign key should have prevented this.</p>
      <table class="table is-fullwidth is-narrow is-striped">
        <thead>
          <tr>
            <th>Proto</th>
            <th>Port(s)</th>
            <th>Description</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @orphans.each do |row| %>
            <tr>
              <td><span class="tag"><%= row[:proto] %></span></td>
              <% last = row[:port_end] || row[:port] %>
              <td><code><%= (last == row[:port]) ? row[:port] : "#{row[:port]}-#{last}" %></code></td>
              <td><%= row[:description] %></td>
              <td>
                <form method="post" action="/exposed-ports/<%= row[:id] %>/delete">
                  <%= csrf_tag("/exposed-ports/#{row[:id]}/delete") %>
                  <button class="button is-small is-danger is-light" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<hr>

<h2 class="title is-5">Expose a port</h2>
<% if @clients.empty? %>
  <div class="notification is-warning">Add a client first.</div>
<% else %>
  <form method="post" action="/exposed-ports">
    <%= csrf_tag("/exposed-ports") %>
    <div class="field is-grouped is-grouped-multiline">
      <div class="control">
        <label class="label">Client</label>
        <div class="select">
          <select name="client_id" required>
            <% @clients.each do |c| %>
              <option value="<%= c[:id] %>"><%= c[:name] %> (<%= c[:wg_ip] %>)</option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="control">
        <label class="label">Protocol</label>
        <div class="select">
          <select name="proto">
            <option value="tcp">tcp</option>
            <option value="udp">udp</option>
          </select>
        </div>
      </div>
      <div class="control">
        <label class="label">Port(s)</label>
        <input class="input" type="text" name="port" pattern="\d{1,5}(-\d{1,5})?"
               placeholder="22 or 8000-8100" required>
        <p class="help">A single port, or an inclusive range.</p>
      </div>
      <div class="control is-expanded">
        <label class="label">Description <span class="has-text-grey">(optional)</span></label>
        <input class="input" type="text" name="description" placeholder="ssh">
      </div>
    </div>
    <div class="field">
      <div class="control">
        <button class="button is-primary" type="submit">Expose &amp; apply</button>
      </div>
    </div>
  </form>
<% end %>
