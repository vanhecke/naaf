<div class="level">
  <div class="level-left">
    <h1 class="title level-item">Exposed ports</h1>
  </div>
</div>

<p class="content">
  Ports a spoke is allowed to accept <em>from other spokes</em>. Everything else
  between spokes is denied (ICMP echo aside). Each change regenerates
  <code>inet wgcp</code> and applies it atomically.
</p>

<% if @rows.empty? %>
  <div class="notification">
    No exposed ports. Spoke-to-spoke traffic is fully denied.
  </div>
<% else %>
  <% by_id = @clients.to_h { |c| [c[:id], c] } %>
  <table class="table is-fullwidth is-striped is-hoverable">
    <thead>
      <tr>
        <th>Client</th>
        <th>VPN IP</th>
        <th>Proto</th>
        <th>Port(s)</th>
        <th>Description</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <% c = by_id[row[:client_id]] %>
        <tr>
          <td><%= c ? c[:name] : "—" %></td>
          <td><code><%= c ? c[:wg_ip] : "?" %></code></td>
          <td><span class="tag"><%= row[:proto] %></span></td>
          <% last = row[:port_end] || row[:port] %>
          <td><code><%= (last == row[:port]) ? row[:port] : "#{row[:port]}-#{last}" %></code></td>
          <td><%= row[:description] %></td>
          <td>
            <form method="post" action="/exposed-ports/<%= row[:id] %>/delete">
              <%= csrf_tag("/exposed-ports/#{row[:id]}/delete") %>
              <button class="button is-small is-danger is-light" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<hr>

<h2 class="title is-5">Expose a port</h2>
<% if @clients.empty? %>
  <div class="notification is-warning">Add a client first.</div>
<% else %>
  <form method="post" action="/exposed-ports">
    <%= csrf_tag("/exposed-ports") %>
    <div class="field is-grouped is-grouped-multiline">
      <div class="control">
        <label class="label">Client</label>
        <div class="select">
          <select name="client_id" required>
            <% @clients.each do |c| %>
              <option value="<%= c[:id] %>"><%= c[:name] %> (<%= c[:wg_ip] %>)</option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="control">
        <label class="label">Protocol</label>
        <div class="select">
          <select name="proto">
            <option value="tcp">tcp</option>
            <option value="udp">udp</option>
          </select>
        </div>
      </div>
      <div class="control">
        <label class="label">Port(s)</label>
        <input class="input" type="text" name="port" pattern="\d{1,5}(-\d{1,5})?"
               placeholder="22 or 8000-8100" required>
        <p class="help">A single port, or an inclusive range.</p>
      </div>
      <div class="control is-expanded">
        <label class="label">Description <span class="has-text-grey">(optional)</span></label>
        <input class="input" type="text" name="description" placeholder="ssh">
      </div>
    </div>
    <div class="field">
      <div class="control">
        <button class="button is-primary" type="submit">Expose &amp; apply</button>
      </div>
    </div>
  </form>
<% end %>
