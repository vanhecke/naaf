<header class="page-head">
  <h1>Exposed ports</h1>
</header>

<p class="lede">
  Ports a spoke is allowed to accept <em>from other spokes</em>. Everything else
  between spokes is denied (ICMP echo aside). Each change regenerates
  <code>inet naaf</code> and applies it atomically.
</p>

<% if @groups.all? { |g| g[:rows].empty? } && @orphans.empty? %>
  <p class="empty">
    No exposed ports. Spoke-to-spoke traffic is fully denied.
  </p>
<% end %>

<%# Every client gets a panel, empty ones included. The page is opened to answer
    "what can reach this machine", and an absent client reads as "I have not
    looked yet" rather than as "nothing". %>
<% @groups.each do |group| %>
  <% c = group[:client] %>
  <% rows = group[:rows] %>
  <section class="panel">
    <div class="record-head">
      <h2 class="panel-title"><%= h(c[:name]) %></h2>
      <code><%= h(c[:wg_ip]) %></code>
      <span class="kind"><%= rows.size %></span>
    </div>
    <% if rows.empty? %>
      <p class="muted">No ports exposed. Other spokes cannot reach this client.</p>
    <% else %>
      <table class="table compact">
        <thead>
          <tr>
            <th>Proto</th>
            <th>Port(s)</th>
            <th>Description</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr>
              <td><span class="kind"><%= row[:proto] %></span></td>
              <% last = row[:port_end] || row[:port] %>
              <td><code><%= (last == row[:port]) ? row[:port] : "#{row[:port]}-#{last}" %></code></td>
              <td><%= row[:description] %></td>
              <td>
                <details class="confirm">
                  <summary>Delete</summary>
                  <form method="post" action="/exposed-ports/<%= row[:id] %>/delete">
                    <%= csrf_tag("/exposed-ports/#{row[:id]}/delete") %>
                    <button class="btn btn-danger-solid" type="submit">Confirm delete</button>
                  </form>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>

<% unless @orphans.empty? %>
  <div class="panel naaf-warn">
    <h2 class="panel-title">Orphaned ports</h2>
    <p>These rows have no matching client. The foreign key should have prevented this.</p>
    <table class="table compact">
      <thead>
        <tr>
          <th>Proto</th>
          <th>Port(s)</th>
          <th>Description</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orphans.each do |row| %>
          <tr>
            <td><span class="kind"><%= row[:proto] %></span></td>
            <% last = row[:port_end] || row[:port] %>
            <td><code><%= (last == row[:port]) ? row[:port] : "#{row[:port]}-#{last}" %></code></td>
            <td><%= row[:description] %></td>
            <td>
              <details class="confirm">
                <summary>Delete</summary>
                <form method="post" action="/exposed-ports/<%= row[:id] %>/delete">
                  <%= csrf_tag("/exposed-ports/#{row[:id]}/delete") %>
                  <button class="btn btn-danger-solid" type="submit">Confirm delete</button>
                </form>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<hr class="rule">

<h2 class="section">Expose a port</h2>
<% if @clients.empty? %>
  <p class="callout callout-once">Add a client first.</p>
<% else %>
  <form method="post" action="/exposed-ports">
    <%= csrf_tag("/exposed-ports") %>
    <div class="fields">
      <label class="field">
        <span class="label">Client</span>
        <select class="input" name="client_id" required>
          <% @clients.each do |c| %>
            <option value="<%= c[:id] %>"><%= c[:name] %> (<%= c[:wg_ip] %>)</option>
          <% end %>
        </select>
      </label>
      <label class="field">
        <span class="label">Protocol</span>
        <select class="input" name="proto">
          <option value="tcp">tcp</option>
          <option value="udp">udp</option>
        </select>
      </label>
      <label class="field">
        <span class="label">Port(s)</span>
        <input class="input" type="text" name="port" pattern="\d{1,5}(-\d{1,5})?"
               placeholder="22 or 8000-8100" required>
        <span class="help">A single port, or an inclusive range.</span>
      </label>
      <label class="field grow">
        <span class="label">Description <span class="hint">(optional)</span></span>
        <input class="input" type="text" name="description" placeholder="ssh">
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Expose &amp; apply</button>
  </form>
<% end %>
