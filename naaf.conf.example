# Naaf — the one configuration file.
#
# Copy to `naaf.conf` (gitignored) and edit. Deploy installs it to
# /etc/naaf/naaf.conf on the box, mode 0640 root:naaf.
#
# It is consumed three ways, so the grammar is the intersection of all three:
#   1. systemd   EnvironmentFile=/etc/naaf/naaf.conf   (naaf.service, naaf-helper.service)
#   2. shell     set -a; . /etc/naaf/naaf.conf; set +a  (deploy/provision/00-lib.sh)
#   3. ruby      lib/naaf/config.rb                     (bin/naaf, bin/naaf-helper)
#
# Rules, all three enforced by bin/ci:
#   KEY=value, one per line. No `export`. No $VAR, no backticks, no backslashes.
#   Single quotes only, and only when the value contains a space.
#   Comments start with # in column 1.
#
# Precedence in Ruby: environment > this file > the defaults in lib/naaf/config.rb.
# An empty value means "unset" and falls through to the default.

# ─────────────────────────────────────────────────────────────── identity
NAAF_USER=naaf
NAAF_GROUP=naaf

# ────────────────────────────────────────────────────────────────── paths
NAAF_APP_DIR=/opt/naaf
NAAF_STATE_DIR=/var/lib/naaf
NAAF_DB=/var/lib/naaf/naaf.db
NAAF_RUN_DIR=/run/naaf
NAAF_HELPER_SOCKET=/run/naaf/helper.sock
NAAF_WG_CONF_DIR=/etc/wireguard
NAAF_LOG_DIR=/var/log/naaf-provision
# The Ruby install prefix is derived from NAAF_RUBY_VERSION (below) as
# /opt/rubies/ruby-<version>. Deliberately not a key here: setting it would
# shadow the version, so bumping NAAF_RUBY_VERSION alone would do nothing.
# Override with NAAF_RUBY_PREFIX in the environment if you really need to.

# ───────────────────────────────────────────────────────── listen / session
# The admin UI binds NAAF_SERVER_IP and 127.0.0.1 only. Never 0.0.0.0.
NAAF_WEB_PORT=8080
NAAF_DNS_PORT=53
NAAF_RECONCILE_INTERVAL=30

# REQUIRED. 128 hex chars, generated by deploy/provision/40-app.sh if left empty.
# Rotating it logs the admin out. Never commit a filled-in copy of this file.
NAAF_SESSION_SECRET=
NAAF_SESSION_COOKIE=naaf.session
NAAF_SESSION_DAYS=7

# ──────────────────────────────────────────── first-boot seeds (the DB wins)
# These seed the single-row `settings` table on FIRST boot only. After that the
# database is authoritative and the admin UI edits it — changing a value here
# does nothing on a box that is already bootstrapped. Naaf logs a warning at boot
# if a value here disagrees with the database.
#
# Structural — read-only in the UI. Changing them needs a re-provision: they
# re-bind listeners and invalidate every issued client config.
NAAF_WG_INTERFACE=wg0
NAAF_WG_SUBNET=10.8.0.0/24
NAAF_SERVER_IP=10.8.0.1
NAAF_LISTEN_PORT=51820

# Editable in the UI after first boot.
NAAF_WAN_INTERFACE=eth0
NAAF_DNS_UPSTREAM=1.1.1.1
NAAF_DNS_DOMAIN=vpn
NAAF_MTU=1420

# The FQDN clients dial. Leave blank and clients dial the detected public IPv4,
# which pins them to this box. Set it to a name you control and you can migrate
# to a new box by repointing DNS, with no client reconfiguration.
NAAF_ENDPOINT_HOST=

# The box's own public addresses. Normally detected at bootstrap; set these only
# when detection cannot work — no outbound HTTP, or the box is behind NAT and the
# address it sees is not the one clients must dial.
NAAF_ENDPOINT_V4=
NAAF_ENDPOINT_V6=

# ──────────────────────────────────────────────────────────────── backups
# Hourly VACUUM INTO snapshots, taken in-process on the shared reactor.
# They contain the server private key — mode 0600, and treat them accordingly.
NAAF_BACKUP_ENABLED=1
NAAF_BACKUP_DIR=/var/lib/naaf/backups
NAAF_BACKUP_INTERVAL=3600
NAAF_BACKUP_KEEP=24

# ───────────────────────────────────────────────────────────── litestream
# Continuous replication. Off by default. See docs/BACKUP.md.
#
# REPLICA_TYPE=file needs no cloud account. On the same disk it survives an
# application bug or an accidental delete — NOT a dead disk or a destroyed VPS.
# Point it at a mounted volume for a genuine second copy.
#
# REPLICA_TYPE=s3 works with AWS, Cloudflare R2, Backblaze B2, MinIO, Wasabi.
# Credentials do NOT go in this file: it is EnvironmentFile= for naaf.service, so
# every key here lands in the web application's environment. Object-store keys go
# in /etc/naaf/litestream.env instead, read only by litestream.
NAAF_LITESTREAM_ENABLED=0
NAAF_LITESTREAM_VERSION=0.5.16
NAAF_LITESTREAM_REPLICA_TYPE=file
NAAF_LITESTREAM_PATH=/var/lib/naaf/replica
NAAF_LITESTREAM_BUCKET=
NAAF_LITESTREAM_PREFIX=naaf
NAAF_LITESTREAM_REGION=
NAAF_LITESTREAM_ENDPOINT=
NAAF_LITESTREAM_SNAPSHOT_INTERVAL=24h
NAAF_LITESTREAM_SNAPSHOT_RETENTION=168h

# ══════════════════════════════ WORKSTATION ONLY ══════════════════════════════
# Everything below this marker is used by the deploy scripts on your machine and
# is STRIPPED before the file is installed on a box. Do not move it above the
# marker — provider tokens have no business in the VPN server's environment.
#
# NAAF_ADMIN_PASSWORD is deliberately absent: `./deploy.sh` asks for it once on a
# first deploy and ships it to a root-only file the box deletes in the same
# command; bin/bootstrap.rb bcrypt-hashes it into the database. The hash lives in
# the database forever; the plaintext should live nowhere.

# The box to deploy to, and how to reach it — `./deploy.sh` with no arguments
# deploys to NAAF_SSH_HOST. Leave NAAF_SSH_KEY blank to use your normal ssh
# config and agent.
NAAF_SSH_HOST=
NAAF_SSH_USER=root
NAAF_SSH_KEY=

NAAF_RUBY_VERSION=4.0.6
NAAF_SWAP_GB=2

# Optional provider examples (deploy/providers/), used only by `./deploy.sh
# --create`. Leave both blank to bring your own box: everything else here works
# against any Debian 13 host you can already reach as root over SSH.
#
#   NAAF_PROVIDER      runs deploy/providers/<name>/create-box.sh   (e.g. vultr)
#   NAAF_DNS_PROVIDER  runs deploy/providers/<name>/update-record.sh (e.g. dnsimple)
#
# With NAAF_DNS_PROVIDER set, EVERY full deploy points the record below at the box
# it deploys to — so deploying to a different host moves the name with it.
NAAF_PROVIDER=
NAAF_DNS_PROVIDER=

# Every account-specific value below is required with no default: a hardcoded key
# id or DNS zone would silently build a box in, or rewrite a record belonging to,
# someone else's account.
#   Vultr:    NAAF_SSH_KEY_ID (vultr-cli ssh-key list), NAAF_REGION, NAAF_PLAN,
#             NAAF_OS, NAAF_HOSTNAME, NAAF_LABEL, NAAF_FIREWALL_GROUP,
#             NAAF_FW_DESC, NAAF_SSH_SRC_IP
#   DNSimple: NAAF_DNS_ZONE (example.com), NAAF_DNS_NAME (vpn), NAAF_DNS_TTL
#
# With a DNS provider set, NAAF_DNS_NAME.NAAF_DNS_ZONE also fills in
# NAAF_ENDPOINT_HOST on a --create deploy, so clients dial the name and the box
# stays migratable.
