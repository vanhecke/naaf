# Naaf — the one configuration file.
#
# Copy to `naaf.conf` (gitignored) and edit. Deploy installs it to
# /etc/naaf/naaf.conf on the box, mode 0640 root:naaf.
#
# It is consumed three ways, so the grammar is the intersection of all three:
#   1. systemd   EnvironmentFile=/etc/naaf/naaf.conf   (naaf.service, naaf-helper.service)
#   2. shell     set -a; . /etc/naaf/naaf.conf; set +a  (deploy/provision/00-lib.sh)
#   3. ruby      lib/naaf/config.rb                     (bin/naaf, bin/naaf-helper)
#
# Rules, all three enforced by bin/ci:
#   KEY=value, one per line. No `export`. No $VAR, no backticks, no backslashes.
#   Single quotes only, and only when the value contains a space.
#   Comments start with # in column 1.
#
# Precedence in Ruby: environment > this file > the defaults in lib/naaf/config.rb.
# An empty value means "unset" and falls through to the default.

# ─────────────────────────────────────────────────────────────── identity
NAAF_USER=naaf
NAAF_GROUP=naaf

# ────────────────────────────────────────────────────────────────── paths
NAAF_APP_DIR=/opt/naaf
NAAF_STATE_DIR=/var/lib/naaf
NAAF_DB=/var/lib/naaf/naaf.db
NAAF_RUN_DIR=/run/naaf
NAAF_HELPER_SOCKET=/run/naaf/helper.sock
NAAF_WG_CONF_DIR=/etc/wireguard
NAAF_LOG_DIR=/var/log/naaf-provision
# The Ruby install prefix is derived from NAAF_RUBY_VERSION (below) as
# /opt/rubies/ruby-<version>. Deliberately not a key here: setting it would
# shadow the version, so bumping NAAF_RUBY_VERSION alone would do nothing.
# Override with NAAF_RUBY_PREFIX in the environment if you really need to.

# ───────────────────────────────────────────────────────── listen / session
# The admin UI binds NAAF_SERVER_IP and 127.0.0.1 only. Never 0.0.0.0.
NAAF_WEB_PORT=8080
NAAF_DNS_PORT=53
NAAF_DNS_UPSTREAM_TIMEOUT=4
NAAF_RECONCILE_INTERVAL=30

# REQUIRED. 128 hex chars, generated by deploy/provision/40-app.sh if left empty.
# Rotating it logs the admin out. Never commit a filled-in copy of this file.
NAAF_SESSION_SECRET=
NAAF_SESSION_COOKIE=naaf.session
NAAF_SESSION_DAYS=7

# ─────────────────────────────────────────────────────── dashboard / metrics
# The dashboard at / is fed by in-memory ring buffers, never by the database: a
# metrics table would multiply the WAL churn Litestream replicates, and naaf.db
# is configuration truth. History therefore resets when the process restarts.
#
# INTERVAL is the sample period in seconds and HISTORY the number of samples
# kept per series, so 2 x 180 is six minutes of chart. Peer throughput is a
# separate, coarser cadence — it can only be as fresh as
# NAAF_RECONCILE_INTERVAL, because the only reader of kernel peer state is the
# reconciler. Lower that if you want a livelier per-client chart.
NAAF_METRICS_INTERVAL=2
NAAF_METRICS_HISTORY=180
# 1 = push updates over a single server-sent-events stream. Set to 0 if
# something between you and the box buffers text/event-stream; the page then
# polls the same fragments every NAAF_METRICS_POLL_INTERVAL seconds instead.
NAAF_METRICS_SSE=1
NAAF_METRICS_POLL_INTERVAL=5
# 1 = also keep the most-queried domain names and per-client query counts, in
# memory only and never written anywhere. Set to 0 to keep aggregate rates and
# nothing that could identify what anyone looked up.
NAAF_METRICS_DNS_NAMES=1

# ───────────────────────────────────────────────────── troubleshoot page
# ping, traceroute and curl, runnable from the admin UI. They run as the naaf
# user in the web process — unprivileged, absolute-path, argv-array, never a
# shell string — and are the ONLY commands this process spawns. The root helper
# vocabulary is unchanged. Set to 0 to remove the three routes and their panels
# entirely; the flow tester reads the database only and stays either way.
NAAF_DIAG_ENABLED=1
# Hard deadline per run, seconds. Each tool also carries its own shorter
# deadline; this is the backstop that kills a tool ignoring its own.
NAAF_DIAG_TIMEOUT=10
# How many may run at once, process-wide. A retrying browser tab must not be
# able to fork a box that also routes everyone's traffic.
NAAF_DIAG_CONCURRENCY=2

# ──────────────────────────────────────────── first-boot seeds (the DB wins)
# These seed the single-row `settings` table on FIRST boot only. After that the
# database is authoritative and the admin UI edits it — changing a value here
# does nothing on a box that is already bootstrapped. Naaf logs a warning at boot
# if a value here disagrees with the database.
#
# Structural — read-only in the UI. Changing them needs a re-provision: they
# re-bind listeners and invalidate every issued client config.
NAAF_WG_INTERFACE=wg0
NAAF_WG_SUBNET=10.8.0.0/24
NAAF_SERVER_IP=10.8.0.1
NAAF_LISTEN_PORT=51820

# Editable in the UI after first boot.
NAAF_WAN_INTERFACE=eth0
NAAF_DNS_UPSTREAM=1.1.1.1
NAAF_DNS_DOMAIN=vpn
NAAF_MTU=1420

# The FQDN clients dial. Leave blank and clients dial the detected public IPv4,
# which pins them to this box. Set it to a name you control and you can migrate
# to a new box by repointing DNS, with no client reconfiguration.
#
# It is also the certificate's name (docs/CERTS.md): blank means the endpoint is
# a bare address, no public CA can certify it, and the box keeps its self-signed
# certificate even with NAAF_ACME_ENABLED=1. Unlike the Settings UI this value
# reaches the database unvalidated — a trailing dot is normalised away when the
# certificate directory is named, anything else that is not a plain hostname
# leaves the store empty and fails 65-wstunnel.
NAAF_ENDPOINT_HOST=

# The box's own public addresses. Normally detected at bootstrap; set these only
# when detection cannot work — no outbound HTTP, or the box is behind NAT and the
# address it sees is not the one clients must dial.
NAAF_ENDPOINT_V4=
NAAF_ENDPOINT_V6=

# ──────────────────────────────────────────────────────────────── backups
# Hourly VACUUM INTO snapshots, taken in-process on the shared reactor.
# They contain the server private key — mode 0600, and treat them accordingly.
NAAF_BACKUP_ENABLED=1
NAAF_BACKUP_DIR=/var/lib/naaf/backups
NAAF_BACKUP_INTERVAL=3600
NAAF_BACKUP_KEEP=24

# ───────────────────────────────────────────────────────────── litestream
# Continuous replication. Off by default. See docs/BACKUP.md.
#
# REPLICA_TYPE=file needs no cloud account. On the same disk it survives an
# application bug or an accidental delete — NOT a dead disk or a destroyed VPS.
# Point it at a mounted volume for a genuine second copy.
#
# REPLICA_TYPE=s3 works with AWS, Cloudflare R2, Backblaze B2, MinIO, Wasabi.
# CREATE THE BUCKET FIRST — litestream never creates one, and a missing bucket
# looks like a credentials error. Cloudflare R2 is the cheap default (10 GB free,
# no egress fee) and wants REGION=auto with
# ENDPOINT=https://<account-id>.r2.cloudflarestorage.com.
#
# The replica is NOT encrypted: litestream 0.5 removed age encryption, so an s3
# replica holds server_privkey in plaintext at your provider. Keep the bucket
# private and dedicated to this. See docs/BACKUP.md.
#
# Credentials do NOT go in this file: it is EnvironmentFile= for naaf.service, so
# every key here lands in the web application's environment. Object-store keys go
# in /etc/naaf/litestream.env instead, read only by litestream. Pass them once at
# provisioning time:
#   export NAAF_LITESTREAM_ACCESS_KEY_ID=... NAAF_LITESTREAM_SECRET_ACCESS_KEY=...
#   ./deploy.sh --step 45-litestream
NAAF_LITESTREAM_ENABLED=0
NAAF_LITESTREAM_VERSION=0.5.16
NAAF_LITESTREAM_REPLICA_TYPE=file
NAAF_LITESTREAM_PATH=/var/lib/naaf/replica
NAAF_LITESTREAM_BUCKET=
NAAF_LITESTREAM_PREFIX=naaf
NAAF_LITESTREAM_REGION=
NAAF_LITESTREAM_ENDPOINT=
NAAF_LITESTREAM_SNAPSHOT_INTERVAL=24h
NAAF_LITESTREAM_SNAPSHOT_RETENTION=168h

# ────────────────────────────────────────────────────────────────── wstunnel
# WireGuard datagrams inside a TLS WebSocket, so the outer path is an ordinary
# outbound TCP connection to :443. That traverses a network which passes only
# tcp/443, and it works from inside someone else's full tunnel. It adds two
# client config flavors, split-ws and split-ws-nodns. See docs/WSTUNNEL.md.
#
# Off by default, and the switch is all-or-nothing: with 0 the firewall port
# stays shut, the unit is not installed, and the flavors are not offered. An
# open 443 with nothing behind it is an advertisement.
#
# These are keys here and NOT columns in the settings table on purpose. The port
# has to match the systemd unit AND /etc/nftables.conf, both rendered from this
# file at provisioning time, and a database copy would be a second source of
# truth that drifts. The host clients dial is still NAAF_ENDPOINT_HOST.
#
# The shared path prefix is deliberately not a key here. It is generated on the
# box into /etc/naaf/wstunnel.env by deploy/provision/65-wstunnel.sh, because a
# key that lives here but is blank in your copy gets regenerated on every
# deploy — silently invalidating every split-ws config you have issued.
#
# Two constraints the ws flavors add, both enforced rather than documented-only:
#   * An extra route (Routes page) of 0.0.0.0/0, or any CIDR covering the box's
#     public address, makes a split-ws download fail with a 500 — it would route
#     wstunnel's own TCP session into the tunnel it carries. Plain split still
#     renders and only logs a warning. docs/WSTUNNEL.md section 5.
#   * While this is 1, tcp/NAAF_WSTUNNEL_PORT cannot be used as a port forward:
#     the DNAT would take the transport's port away from the box.
# And one that is not: a client machine can run only ONE ws tunnel at a time —
# the relay's pidfile and local port are constants, and the second `wg-quick up`
# refuses rather than orphaning the first relay.
NAAF_WSTUNNEL_ENABLED=0
NAAF_WSTUNNEL_VERSION=10.6.2
NAAF_WSTUNNEL_PORT=443

# The name that goes on the wire as SNI. Blank means "the host you dial", which
# is already the right answer — set this only to show a cover name to a firewall
# that decides whether to decrypt by reading the SNI. It applies fleet-wide;
# there is no per-client value, because wstunnel's server never inspects SNI.
NAAF_WSTUNNEL_SNI=

# auto | on | off. `auto` verifies the server certificate when ACME is on and no
# SNI override is set — exactly when the dialed name and the served certificate
# agree. `on` together with NAAF_WSTUNNEL_SNI is the strong form and needs a
# real certificate for the cover name. `off` never verifies.
NAAF_WSTUNNEL_TLS_VERIFY=auto

# The resolver wstunnel uses to look up the endpoint. Load-bearing: the ws
# flavors set DNS to the tunnel's own resolver, and wstunnel must resolve the
# endpoint before that tunnel exists — without this the two wait on each other
# and the tunnel never comes up. Set it to "off" to omit the flag — not blank,
# which means "unset" and falls through to the default (then use a
# split-ws-nodns config, which never repoints DNS at all).
NAAF_WSTUNNEL_DNS_RESOLVER=dns://1.1.1.1

# ────────────────────────────────────────────────────────────── certificates
# A general-purpose certificate store, owned by deploy/provision/60-certs.sh.
# wstunnel is its first consumer, not its owner: consumers register themselves
# in <cert>/consumers.d/ and inherit renewal, rather than each growing its own
# ACME path. See docs/CERTS.md.
#
# Every box gets its own certificate no matter what. wstunnel's embedded one is
# compiled into the binary and byte-identical on every deployment in the world,
# which makes it a perfect fingerprint.
#
# Self-signed by default, and that is a complete, supported configuration. Turn
# ACME on for a real Let's Encrypt certificate. Challenge type is DNS-01 only,
# so nothing inbound is ever opened — tcp/80 stays closed — and it can issue for
# wildcards and for names that do not resolve to this box.
#
# The DNS API token does NOT belong in this file: it is EnvironmentFile= for
# naaf.service, so every key here lands in the web app's environment, and this
# credential can rewrite DNS. Pass it once at provisioning time instead —
#   export NAAF_ACME_DNS_TOKEN=...
#   ./deploy.sh --sync && ./deploy.sh --step 60-certs
# — and 60-certs writes it to /etc/naaf/acme.env, 0600 root:root, unreadable by
# the naaf user. Give the box a token scoped to a SEPARATE provider account
# holding only the delegation zone: the account boundary is what contains a box
# compromise, not the CNAME.
NAAF_CERT_DIR=/etc/naaf/certs
NAAF_ACME_ENABLED=0
NAAF_ACME_EMAIL=
# letsencrypt, letsencrypt_test, or any other CA alias acme.sh knows. Use
# letsencrypt_test for the first run: production locks you out for a week after
# five failed validations.
NAAF_ACME_SERVER=letsencrypt
NAAF_ACME_DNS_API=dns_dnsimple
# The zone you delegated _acme-challenge to by CNAME. Leave blank to validate in
# the endpoint's own zone with a token that can rewrite it.
NAAF_ACME_CHALLENGE_ALIAS=
# Extra certificates beyond the endpoint's own: one certificate per
# space-separated entry, SANs comma-separated within an entry, the whole value
# single-quoted because it contains a space. A `*` here is literal — no globbing
# applies to a shell assignment. Leave this EMPTY unless you mean it: a
# filled-in sample would ask a rate-limited CA for names you do not own. So the
# worked example stays a comment:
#   NAAF_ACME_DOMAINS='vpn.example.com,*.vpn.example.com apps.example.com'
# An entry whose FIRST SAN is the endpoint host names the same certificate the
# endpoint already has: its extra SANs are MERGED into that one rather than
# dropped, so the entry above is how the endpoint certificate grows a wildcard.
NAAF_ACME_DOMAINS=
# acme.sh is installed from a git clone pinned to the tag AND checked against
# the commit that tag pointed at, because a tag can be moved. Bump both together.
NAAF_ACME_SH_VERSION=3.1.4
NAAF_ACME_SH_COMMIT=3661fd86b6304115e42f43910e6dd452ab9866d6

# ══════════════════════════════ WORKSTATION ONLY ══════════════════════════════
# Everything below this marker is used by the deploy scripts on your machine and
# is STRIPPED before the file is installed on a box. Do not move it above the
# marker — provider tokens have no business in the VPN server's environment.
#
# NAAF_ADMIN_PASSWORD is deliberately absent: `./deploy.sh` asks for it once on a
# first deploy and ships it to a root-only file the box deletes in the same
# command; bin/bootstrap.rb bcrypt-hashes it into the database. The hash lives in
# the database forever; the plaintext should live nowhere.

# The box to deploy to, and how to reach it — `./deploy.sh` with no arguments
# deploys to NAAF_SSH_HOST. Leave NAAF_SSH_KEY blank to use your normal ssh
# config and agent.
NAAF_SSH_HOST=
NAAF_SSH_USER=root
NAAF_SSH_KEY=

# Ruby is installed by rv (https://rv.dev) as a prebuilt, checksum-verified
# tarball — seconds, not a 15-30 minute source compile. NAAF_RUBY_VERSION must be
# a version rv publishes a build for: `rv ruby list` shows them, and provisioning
# fails loudly rather than silently falling back to something else.
NAAF_RUBY_VERSION=4.0.6
NAAF_RV_VERSION=0.6.0
NAAF_SWAP_GB=2

# Optional provider examples (deploy/providers/), used only by `./deploy.sh
# --create`. Leave both blank to bring your own box: everything else here works
# against any Debian 13 host you can already reach as root over SSH.
#
#   NAAF_PROVIDER      runs deploy/providers/<name>/create-box.sh   (e.g. vultr)
#   NAAF_DNS_PROVIDER  runs deploy/providers/<name>/update-record.sh (e.g. dnsimple)
#
# With NAAF_DNS_PROVIDER set, EVERY full deploy points the record below at the box
# it deploys to — so deploying to a different host moves the name with it.
NAAF_PROVIDER=
NAAF_DNS_PROVIDER=

# Every account-specific value below is required with no default: a hardcoded key
# id or DNS zone would silently build a box in, or rewrite a record belonging to,
# someone else's account.
#   Vultr:    NAAF_SSH_KEY_ID (vultr-cli ssh-key list), NAAF_REGION, NAAF_PLAN,
#             NAAF_OS, NAAF_HOSTNAME, NAAF_LABEL, NAAF_FIREWALL_GROUP,
#             NAAF_FW_DESC, NAAF_SSH_SRC_IP
#   DNSimple: NAAF_DNS_ZONE (example.com), NAAF_DNS_NAME (vpn), NAAF_DNS_TTL
#
# With a DNS provider set, NAAF_DNS_NAME.NAAF_DNS_ZONE also fills in
# NAAF_ENDPOINT_HOST on a --create deploy, so clients dial the name and the box
# stays migratable.
