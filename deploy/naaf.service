# Install as /etc/systemd/system/naaf.service.
# The __PLACEHOLDERS__ are substituted from naaf.conf by deploy/provision/40-app.sh.
[Unit]
Description=Naaf control plane (web + dns + reconciler)
After=naaf-helper.service wg-quick@__NAAF_WG_INTERFACE__.service
Requires=naaf-helper.service

[Service]
Type=simple
User=__NAAF_USER__
Group=__NAAF_GROUP__
WorkingDirectory=__NAAF_APP_DIR__
EnvironmentFile=/etc/naaf/naaf.conf
# The wstunnel path prefix, and only that. It is NOT a naaf.conf key on purpose:
# deploy/install-config.sh iterates the incoming file only, so a key that exists
# on the box but not in the operator's local naaf.conf is dropped and then
# regenerated — which would silently invalidate every split-ws config ever
# issued. Its own file, written by 65-wstunnel.sh, keeps it out of that path.
# The leading `-` means a box without the transport is not an error.
EnvironmentFile=-/etc/naaf/wstunnel.env
Environment=BUNDLE_GEMFILE=__NAAF_APP_DIR__/Gemfile
Environment=RUBY_YJIT_ENABLE=1
ExecStart=__NAAF_RUBY_BIN__ __NAAF_APP_DIR__/bin/naaf
Restart=on-failure
RestartSec=2
# Open dashboard streams end when the collector task's ensure closes the hub.
# This is the backstop if one ever does not: fail fast on restart rather than
# waiting out the 90s default and being SIGKILLed, possibly mid-snapshot.
TimeoutStopSec=10

# DO NOT add ProcSubset=pid here. It hides every non-process file under /proc —
# stat, meminfo, loadavg, net/dev, net/snmp, sys/net/* — and the dashboard's
# samplers treat an unreadable file as "unavailable" rather than an error, so
# the whole thing would go blank silently. ProtectProc= is safe (the app only
# ever reads /proc/self and the world-readable aggregates).
#
# Only capability needed: bind DNS to port 53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Exactly one writable directory: the database, its WAL, and the backup
# snapshots all live under here. Keep it that way — do not widen this to put
# backups elsewhere. Use a Litestream replica instead (docs/BACKUP.md).
ReadWritePaths=__NAAF_STATE_DIR__

[Install]
WantedBy=multi-user.target
