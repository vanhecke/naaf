# Install as /etc/systemd/system/wgcp.service
[Unit]
Description=wgcp control plane (web + dns + reconciler)
After=wgcp-helper.service wg-quick@wg0.service
Requires=wgcp-helper.service

[Service]
Type=simple
User=wgcp
Group=wgcp
WorkingDirectory=/opt/wgcp
EnvironmentFile=/opt/wgcp/.env
Environment=BUNDLE_GEMFILE=/opt/wgcp/Gemfile
Environment=RUBY_YJIT_ENABLE=1
ExecStart=/opt/rubies/ruby-4.0.6/bin/ruby /opt/wgcp/bin/wgcp
Restart=on-failure
RestartSec=2

# Only capability needed: bind DNS to port 53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wgcp

[Install]
WantedBy=multi-user.target
