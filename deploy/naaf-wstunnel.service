# Install as /etc/systemd/system/naaf-wstunnel.service.
# The __PLACEHOLDERS__ are substituted by deploy/provision/65-wstunnel.sh — NOT
# by 40-app.sh. That step's loop is a fixed six-placeholder set shared by the two
# Ruby units; this unit shares none of the six, and unlike those it is expected
# to be absent from disk entirely whenever NAAF_WSTUNNEL_ENABLED is not 1.
#
# What it does: terminates TLS on tcp/__NAAF_WSTUNNEL_PORT__ and forwards the
# WireGuard datagrams it unwraps from the WebSocket to the kernel's own listener
# on 127.0.0.1:__NAAF_LISTEN_PORT__. That is the entire feature — it exists for
# networks that pass nothing but outbound tcp/443. See docs/WSTUNNEL.md.
[Unit]
Description=Naaf wstunnel transport (WireGuard over TLS WebSocket)
Documentation=https://github.com/erebe/wstunnel
# network.target and nothing else. Deliberately no ordering against wg-quick:
# this forwards to a UDP port, so if the interface is not up yet the datagrams
# are dropped and the client's 5s handshake retry covers the gap. Coupling the
# two would let a transport failure take the tunnel down, which is backwards —
# every other client reaches the hub without this.
After=network.target

[Service]
# Type=exec, not simple: systemd waits for the execve() itself to succeed, so a
# missing binary or an unreadable credential fails the start instead of
# reporting `active` on a process that died a millisecond later.
Type=exec

# DynamicUser, NOT User=naaf. This is the only naaf process that faces the public
# internet, and it holds no state whatsoever. Running it as `naaf` would put a
# transport compromise inside the uid that owns naaf.db — the WireGuard server
# private key and the admin password hash. A transient uid owns nothing.
DynamicUser=yes

# --restrict-http-upgrade-path-prefix is the shared secret: wstunnel rejects any
# WebSocket upgrade that does not carry this prefix, so a scanner finds a server
# that refuses everything rather than a tunnel endpoint. It is generated by
# 65-wstunnel.sh into /etc/naaf/wstunnel.env and never logged — though note it is
# necessarily visible here and in /proc/<pid>/cmdline to anyone already on the
# box, the same trust boundary as a client's own config file.
#
# 127.0.0.1, NOT localhost, in --restrict-to. wstunnel branches on whether the
# host parses as an IP address: an IP becomes a hard /32 CIDR match and the
# server resolves nothing, while a name becomes a literal string both sides must
# spell identically AND forces a glibc NSS lookup that can pick ::1 first.
#
# %d is the credentials directory (see LoadCredential= below) — the certificate
# never has to be readable from the filesystem by this service at all.
ExecStart=/usr/local/bin/wstunnel server \
  --restrict-http-upgrade-path-prefix __NAAF_WSTUNNEL_PATH_PREFIX__ \
  --restrict-to 127.0.0.1:__NAAF_LISTEN_PORT__ \
  --tls-certificate %d/tls-cert \
  --tls-private-key %d/tls-key \
  wss://[::]:__NAAF_WSTUNNEL_PORT__

# The embedded self-signed certificate wstunnel ships with is compiled into the
# binary and therefore byte-identical on every deployment in the world — a
# perfect fingerprint. Every box serves its own instead, from the certificate
# store that 60-certs.sh owns (__NAAF_CERT_PATH__, registered in its
# consumers.d/ so renewals reach us).
#
# LoadCredential= has systemd read both files as root and expose copies under %d
# to this service only, so key.pem stays 0600 root:root on disk and no persistent
# uid can read it. Consequence worth knowing: the credentials directory is a
# START-TIME SNAPSHOT, so wstunnel's own certificate file-watch cannot see a
# renewal. That is why /usr/local/sbin/naaf-cert-reload does a full `systemctl
# restart` rather than relying on the watch — sub-second, roughly every 60 days,
# and WireGuard re-handshakes within 5s.
LoadCredential=tls-cert:__NAAF_CERT_PATH__/cert.pem
LoadCredential=tls-key:__NAAF_CERT_PATH__/key.pem

Restart=on-failure
RestartSec=2

# Only capability needed: bind the privileged port.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Written out in full ON PURPOSE. Do not "make this match naaf.service": that
# unit carries no Restrict* and no SystemCallFilter at all, so mirroring it would
# drop exactly the two classes the only publicly-exposed daemon here most needs.
#
# ProtectSystem=strict, PrivateTmp=yes and RestrictSUIDSGID=yes are already
# implied by DynamicUser=yes. They stay spelled out so the sandbox is legible in
# one place and survives anyone ever changing that line.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No AF_UNIX: systemd connects the journal stream socket before exec, so logging
# needs no socket() call of our own. AF_NETLINK is likewise absent because the
# only addresses in the ExecStart are literals — nothing here resolves a name.
# If a future wstunnel starts touching netlink to enumerate interfaces this is
# the line that will break it, and it will break at startup, loudly.
RestrictAddressFamilies=AF_INET AF_INET6
# NO ReadWritePaths, at all. ProtectSystem=strict plus no exception means the
# whole filesystem is read-only to this process. It has nothing to write.
#
# Deliberately NOT MemoryDenyWriteExecute=yes. It is the one knob here with a
# real chance of killing a third-party binary we merely pin and bump — systemd's
# own documentation warns it breaks programs unexpectedly — and the failure would
# surface after a version bump rather than at review time. @system-service
# already denies the syscalls that matter.

[Install]
WantedBy=multi-user.target
