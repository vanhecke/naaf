#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Runs as root. Accepts newline-delimited JSON on a unix socket.
# FOUR commands, fixed vocabulary. Never builds a shell string. Never evals.

require "json"
require "socket"
require "tempfile"
require "fileutils"
require "etc"
require "ipaddr"
# Stdlib-only and require-free by design — see the comment at the top of that
# file. Loaded by an exact relative path, never via $LOAD_PATH, so nothing on the
# load path can shadow it inside a root process. This is what stops the socket
# path and the interface name being defaulted independently on the two sides of
# the socket, which is a silent way for the app and the helper to disagree.
require_relative "../lib/naaf/config"

SOCKET_PATH = Naaf::Config["NAAF_HELPER_SOCKET"]
WG_IF = Naaf::Config["NAAF_WG_INTERFACE"]
EXIT_IF = Naaf::Config["NAAF_EXIT_INTERFACE"]
WG_CONF = File.join(Naaf::Config["NAAF_WG_CONF_DIR"], "#{WG_IF}.conf")
SOCKET_GID = begin
  Etc.getgrnam(Naaf::Config["NAAF_GROUP"]).gid
rescue ArgumentError
  nil
end

def run!(*argv, stdin: nil)
  out = nil
  IO.popen(argv, "r+", err: [:child, :out]) do |io|
    if stdin
      io.write(stdin)
      io.close_write
    end
    out = io.read
  end
  status = $?
  raise "#{argv.first} failed (#{status.exitstatus}): #{out.to_s.strip}" unless status.success?
  out
end

def write_atomic(path, content, mode)
  FileUtils.mkdir_p(File.dirname(path))
  tmp = "#{path}.tmp.#{Process.pid}"
  File.write(tmp, content)
  File.chmod(mode, tmp)
  File.rename(tmp, path)
end

def cmd_genkeys
  priv = run!("wg", "genkey").strip
  pub = run!("wg", "pubkey", stdin: priv).strip
  psk = run!("wg", "genpsk").strip
  {private_key: priv, public_key: pub, preshared_key: psk}
end

# Site routes are tagged proto 158 so apply can diff them without touching
# the kernel connected route on wg0 (proto kernel) or anything the operator
# added by hand. 158 is otherwise unused on this box. Table 159 is the
# internet-exit routing table — a different number on purpose, and never a
# default in main.
SITE_ROUTE_PROTO = "158"
EXIT_TABLE = "159"
EXIT_RULE_PREFS = [15800, 15850, 15900].freeze
# SOCKS proxy uid rules. Optional `exit.proxy` on apply; an older helper ignores
# the key and the proxy stays on WAN. Not folded into EXIT_RULE_PREFS: that list
# is the exact three `rules` entries an old helper requires, and sending these
# prefs there would reject the whole apply.
PROXY_RULE_PREFS = [15870, 15875, 15880].freeze
ALL_EXIT_RULE_PREFS = (EXIT_RULE_PREFS + PROXY_RULE_PREFS).freeze
EXIT_CONF_BANNED = /\A\s*(Address|DNS|MTU|Table|ListenPort|PreUp|PostUp|PreDown|PostDown|FwMark)\s*=/i
IFACE_NAME = /\A[a-zA-Z0-9._-]{1,15}\z/
V4_DOT = /\A\d{1,3}(\.\d{1,3}){3}\z/
V4_CIDR = /\A\d{1,3}(\.\d{1,3}){3}\/\d{1,2}\z/
RULE_TOKEN = /\A[a-zA-Z0-9.\/:_-]+\z/

def v4_octets?(addr)
  addr.split(".").all? { |o| o.to_i.between?(0, 255) }
end

def valid_v4?(addr)
  V4_DOT.match?(addr) && v4_octets?(addr)
end

# Prefix 0 is a default route and would steal WAN egress. Refuse it here,
# not only in the app: this process is root.
def valid_v4_cidr?(cidr)
  return false unless V4_CIDR.match?(cidr)
  addr, prefix = cidr.split("/", 2)
  p = prefix.to_i
  p.between?(1, 32) && v4_octets?(addr)
end

def cidr_contains?(cidr, addr)
  IPAddr.new(cidr).include?(IPAddr.new(addr))
rescue IPAddr::Error
  false
end

def default_gateway_v4
  run!("ip", "-4", "route", "show", "default").each_line do |line|
    f = line.split
    i = f.index("via")
    return f[i + 1] if i
  end
  nil
end

# Addresses on every interface except wg0 and the exit iface. A site dest
# that covers one of these (or the default gateway) would steal SSH and WAN
# egress. Skipping $EXIT_IF is load-bearing: the moment the exit address is
# on wg-exit it would otherwise join steal_targets and the next apply's
# raise_if_steals!("exit address") would match the exit's own address.
def local_v4_except_wg
  run!("ip", "-4", "-o", "addr", "show").each_line.filter_map do |line|
    f = line.split
    next unless f[2] == "inet"
    next if f[1] == WG_IF || f[1] == EXIT_IF
    f[3].to_s.split("/", 2).first
  end
end

def steal_targets
  [default_gateway_v4, *local_v4_except_wg].compact.uniq
end

def raise_if_steals!(label, cidr_or_host)
  steal_targets.each do |ip|
    next unless cidr_contains?(cidr_or_host.include?("/") ? cidr_or_host : "#{cidr_or_host}/32", ip)
    raise "#{label} #{cidr_or_host} covers #{ip} (default gateway or a local address) — refusing to steal WAN reachability"
  end
end

def cmd_apply(req)
  wg_conf = req.fetch("wg_conf")
  nft = req.fetch("nft_ruleset")
  raise "wg_conf too large" if wg_conf.bytesize > 1_000_000
  raise "nft_ruleset too large" if nft.bytesize > 1_000_000

  write_atomic(WG_CONF, wg_conf, 0o600)

  # wg syncconf applies only the delta -> existing peer sessions are untouched.
  stripped = run!("wg-quick", "strip", WG_IF)
  Tempfile.create(["naaf", ".conf"]) do |f|
    f.write(stripped)
    f.flush
    run!("wg", "syncconf", WG_IF, f.path)
  end

  # The file deletes and recreates table `inet naaf` in ONE transaction.
  Tempfile.create(["naaf", ".nft"]) do |f|
    f.write(nft)
    f.flush
    run!("nft", "-c", "-f", f.path)   # check first
    run!("nft", "-f", f.path)
  end

  # Extra fields are optional so an older helper still answers apply. Routes
  # and addresses are IPv4 on WG_IF only — never another interface, never /0.
  # `exit` is the same contract: a missing key is a no-op (older app); null
  # tears the iface down; an object brings it up.
  sync_site_addrs(req["addresses"] || [])
  sync_site_routes(req["routes"] || [])
  sync_exit(req["exit"]) if req.key?("exit")

  {ok: true}
end

def sync_site_addrs(list)
  raise "addresses must be an array" unless list.is_a?(Array)
  desired = list.map { |item|
    raise "address entry must be an object" unless item.is_a?(Hash)
    dev = item["dev"].to_s
    addr = item["addr"].to_s
    raise "address must be on #{WG_IF}" unless dev == WG_IF && IFACE_NAME.match?(dev)
    raise "invalid site address" unless valid_v4?(addr)
    raise_if_steals!("site address", addr)
    addr
  }.to_set

  current = []
  run!("ip", "-4", "-o", "addr", "show", "dev", WG_IF).each_line do |line|
    next unless line =~ /\binet (\d+\.\d+\.\d+\.\d+)\/(\d+)/
    current << [$1, $2.to_i]
  end
  # Only /32s are site addresses. The interface Address (typically /24) is
  # proto kernel and must not be deleted.
  extras = current.select { |_, prefix| prefix == 32 }.map(&:first).to_set
  (extras - desired).each do |addr|
    run!("ip", "addr", "del", "#{addr}/32", "dev", WG_IF)
  end
  (desired - extras).each do |addr|
    run!("ip", "addr", "replace", "#{addr}/32", "dev", WG_IF)
  end
end

def sync_site_routes(list)
  raise "routes must be an array" unless list.is_a?(Array)
  desired = list.each_with_object({}) { |item, acc|
    raise "route entry must be an object" unless item.is_a?(Hash)
    dst = item["dst"].to_s
    dev = item["dev"].to_s
    raise "route must be on #{WG_IF}" unless dev == WG_IF && IFACE_NAME.match?(dev)
    raise "invalid site route" unless valid_v4_cidr?(dst)
    raise_if_steals!("site route", dst)
    acc[dst] = dev
  }

  current = {}
  run!("ip", "-4", "route", "show", "proto", SITE_ROUTE_PROTO, "dev", WG_IF).each_line do |line|
    dst = line.split.first
    next if dst.nil? || dst == "default"
    current[dst] = WG_IF
  end

  current.each_key do |dst|
    next if desired[dst] == WG_IF
    run!("ip", "route", "del", dst, "proto", SITE_ROUTE_PROTO, "dev", WG_IF)
  end
  desired.each do |dst, dev|
    next if current[dst] == dev
    run!("ip", "route", "replace", dst, "dev", dev, "proto", SITE_ROUTE_PROTO)
  end
end

def cmd_dump
  out = {dump: run!("wg", "show", WG_IF, "dump")}
  if EXIT_IF != WG_IF && iface_exists?(EXIT_IF)
    out[:exit_dump] = run!("wg", "show", EXIT_IF, "dump")
  end
  out
end

def assert_exit_if!
  raise "invalid exit interface #{EXIT_IF}" unless IFACE_NAME.match?(EXIT_IF)
  raise "exit interface must not be #{WG_IF}" if EXIT_IF == WG_IF
end

def iface_exists?(name)
  run!("ip", "link", "show", "dev", name)
  true
rescue
  false
end

def sync_exit(payload)
  assert_exit_if!
  case payload
  when nil then sync_exit_down
  when Hash then sync_exit_up(payload)
  else raise "exit must be an object or null"
  end
end

def sync_exit_up(payload)
  conf = payload["conf"].to_s
  raise "exit conf too large" if conf.bytesize > 1_000_000
  raise "exit conf is not wg-setconf grammar" if conf.each_line.any? { |l| EXIT_CONF_BANNED.match?(l) }

  dev = payload["dev"].to_s
  raise "exit dev must be #{EXIT_IF}" unless dev == EXIT_IF && IFACE_NAME.match?(dev)

  addr = payload["address"].to_s
  raise "invalid exit address" unless valid_v4?(addr)

  mtu = Integer(payload["mtu"].to_s, exception: false)
  raise "invalid exit mtu" unless mtu&.between?(1280, 1500)

  table = payload["table"].to_s
  mark = payload["mark"].to_s
  raise "exit table must be #{EXIT_TABLE}" unless table == EXIT_TABLE
  raise "exit mark must be #{EXIT_TABLE}" unless mark == EXIT_TABLE

  desired_routes = exit_routes(payload["routes"] || [])
  desired_rules = exit_rules(payload["rules"] || [])
  desired_rules.merge!(proxy_uid_rules(payload["proxy"]))

  raise_if_steals!("exit address", addr)

  run!("ip", "link", "add", EXIT_IF, "type", "wireguard") unless iface_exists?(EXIT_IF)

  Tempfile.create(["naaf-exit", ".conf"]) do |f|
    File.chmod(0o600, f.path)
    f.write(conf)
    f.flush
    run!("wg", "syncconf", EXIT_IF, f.path)
  end

  run!("ip", "addr", "replace", "#{addr}/32", "dev", EXIT_IF)
  run!("ip", "link", "set", EXIT_IF, "up", "mtu", mtu.to_s)

  sync_exit_routes(desired_routes)
  sync_exit_rules(desired_rules)
end

def exit_routes(list)
  raise "exit routes must be an array" unless list.is_a?(Array)
  list.each_with_object({}) { |item, acc|
    raise "exit route entry must be an object" unless item.is_a?(Hash)
    dst = item["dst"].to_s
    dev = item["dev"].to_s
    raise "invalid exit route device" unless IFACE_NAME.match?(dev)
    if dst == "default"
      raise "default route must be on #{EXIT_IF}" unless dev == EXIT_IF
    else
      raise "exit site route must be on #{WG_IF}" unless dev == WG_IF
      raise "invalid site route" unless valid_v4_cidr?(dst)
      raise_if_steals!("exit site route", dst)
    end
    acc[norm_dst(dst)] = dev
  }
end

def exit_rules(list)
  raise "exit rules must be an array" unless list.is_a?(Array)
  desired = list.each_with_object({}) { |item, acc|
    raise "exit rule entry must be an object" unless item.is_a?(Hash)
    pref = Integer(item["pref"].to_s, exception: false)
    spec = item["spec"]
    raise "invalid exit rule pref" unless pref && EXIT_RULE_PREFS.include?(pref)
    raise "exit rule spec must be an array" unless spec.is_a?(Array) && spec.any?
    spec = spec.map { |t|
      s = t.to_s
      raise "invalid exit rule token" unless RULE_TOKEN.match?(s)
      s
    }
    acc[pref] = spec
  }
  raise "exit rules must be prefs 15800/15850/15900" unless desired.keys.sort == EXIT_RULE_PREFS
  desired
end

# Optional. Missing or null: no uid rules (and leftover prefs are deleted by
# sync_exit_rules). Locals are `to … lookup main` exemptions so the proxy uid
# can still reach 127.0.0.53 and the VPN subnet; they are NOT routes, so they
# do not go through raise_if_steals! (127.0.0.0/8 covers lo).
def proxy_uid_rules(proxy)
  return {} if proxy.nil?
  raise "exit proxy must be an object" unless proxy.is_a?(Hash)
  uid = Integer(proxy["uid"].to_s, exception: false)
  raise "invalid exit proxy uid" unless uid&.between?(1, 65_534)
  locals = proxy["locals"]
  raise "exit proxy locals must be two CIDRs" unless locals.is_a?(Array) && locals.size == 2
  locals = locals.map { |c|
    s = c.to_s
    raise "invalid exit proxy local" unless valid_v4_cidr?(s)
    s
  }
  uidrange = "#{uid}-#{uid}"
  {
    15870 => ["uidrange", uidrange, "to", locals[0], "lookup", "main"],
    15875 => ["uidrange", uidrange, "to", locals[1], "lookup", "main"],
    15880 => ["uidrange", uidrange, "lookup", EXIT_TABLE]
  }
end

def norm_dst(dst)
  return "default" if dst == "default"
  return "#{dst}/32" if valid_v4?(dst)
  dst
end

# iproute2 6.x exits 2 with "FIB table does not exist" / "Dump terminated"
# (show) or "Flush terminated" (flush) when table 159 has never been
# created. That is the empty state, not a failure: the first `ip route
# replace … table 159` creates it. Treating it as an error bricks apply
# after any enabled-exit deploy, including boot apply with exit: null.
def missing_table?(error)
  msg = error.message
  msg.include?("does not exist") || msg.include?("Dump terminated") || msg.include?("Flush terminated")
end

def table_routes(table)
  run!("ip", "-4", "route", "show", "table", table)
rescue => e
  return "" if missing_table?(e)
  raise
end

def flush_table(table)
  run!("ip", "route", "flush", "table", table)
rescue => e
  return if missing_table?(e)
  raise
end

def sync_exit_routes(desired)
  current = {}
  table_routes(EXIT_TABLE).each_line do |line|
    f = line.split
    next if f.empty?
    i = f.index("dev")
    next unless i
    current[norm_dst(f[0])] = f[i + 1]
  end

  current.each_key do |dst|
    next if desired[dst]
    run!("ip", "route", "del", dst, "table", EXIT_TABLE)
  end
  desired.each do |dst, dev|
    next if current[dst] == dev
    run!("ip", "route", "replace", dst, "dev", dev, "table", EXIT_TABLE)
  end
end

# iproute2 dumps selectors in its own order (`to` before `iif`). Comparing
# the token array to what we add (`iif` then `to`) would del+add pref 15850
# on every apply and open a leak window to main.
RULE_KEYS = %w[from iif oif to fwmark lookup table uidrange].freeze

def spec_key(tokens)
  tokens = tokens.dup
  tokens.shift(2) if tokens[0] == "from" && tokens[1] == "all"
  acc = {}
  i = 0
  while i < tokens.size
    key = tokens[i]
    if RULE_KEYS.include?(key) && tokens[i + 1]
      val = tokens[i + 1]
      if key == "fwmark"
        raw = val.split("/", 2).first
        val = raw.start_with?("0x", "0X") ? raw.to_i(16).to_s : Integer(raw, 10).to_s
      end
      acc[key] = val
      i += 2
    else
      acc[key] = true
      i += 1
    end
  end
  acc
end

def parse_rule_line(line)
  m = /\A(\d+):\s*(.*)\z/.match(line.strip)
  return unless m
  [Integer(m[1], 10), spec_key(m[2].split)]
end

def current_rules
  run!("ip", "-4", "rule", "show").each_line.with_object({}) do |line, acc|
    pref, spec = parse_rule_line(line)
    acc[pref] = spec if pref
  end
end

def delete_rule_pref(pref)
  return unless current_rules.key?(pref)
  run!("ip", "-4", "rule", "del", "pref", pref.to_s)
end

def sync_exit_rules(desired)
  current = current_rules
  ALL_EXIT_RULE_PREFS.each do |pref|
    spec = desired[pref]
    if spec.nil?
      delete_rule_pref(pref)
      next
    end
    next if current[pref] == spec_key(spec)
    delete_rule_pref(pref) if current[pref]
    run!("ip", "-4", "rule", "add", *spec, "pref", pref.to_s)
  end
end

def sync_exit_down
  ALL_EXIT_RULE_PREFS.each { |pref| delete_rule_pref(pref) }
  flush_table(EXIT_TABLE)
  run!("ip", "link", "del", EXIT_IF) if iface_exists?(EXIT_IF)
end

def handle(line)
  req = JSON.parse(line)
  case req["cmd"]
  when "genkeys" then cmd_genkeys
  when "apply" then cmd_apply(req)
  when "dump" then cmd_dump
  when "ping" then {ok: true}
  else raise "unknown command"
  end
rescue => e
  {error: e.message}
end

# Tests load this file as a library of functions (valid_v4_cidr?, handle, …)
# and stub run!. The listen loop is the process entrypoint and must not run
# then — it would bind /run/naaf/helper.sock and never return.
if $PROGRAM_NAME == __FILE__
  FileUtils.rm_f(SOCKET_PATH)
  server = UNIXServer.new(SOCKET_PATH)
  File.chown(0, SOCKET_GID, SOCKET_PATH) if SOCKET_GID
  File.chmod(0o660, SOCKET_PATH)
  warn "naaf-helper listening on #{SOCKET_PATH}"

  loop do
    conn = server.accept
    Thread.new(conn) do |c|
      while (line = c.gets)
        c.puts(JSON.generate(handle(line)))
      end
    rescue => e
      warn "helper connection error: #{e.message}"
    ensure
      c.close
    end
  end
end
