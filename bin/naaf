#!/usr/bin/env ruby
# frozen_string_literal: true

require "async"
require "console"
require "falcon"
require "async/http/endpoint" # NOTE: not autoloaded by `require "falcon"` (verified against falcon 0.55.6)
require "rack/builder"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "naaf/config"
require "naaf/db"
require "naaf/zone"
require "naaf/dns_server"
require "naaf/reconciler"
require "naaf/app"

db       = Naaf.db
settings = Naaf.settings
zone     = Naaf::Zone.new(db)
recon    = Naaf::Reconciler.new(db, zone)
Naaf::App.reconciler = recon

# naaf.conf only seeds the settings table on first boot; the DB is authoritative
# afterwards. Surface a disagreement rather than letting it stay silent — a
# half-finished interface rename otherwise renders nft rules for one interface
# while wg syncconf targets another.
Naaf::Config.drift(settings).each do |d|
  Console.warn("naaf", "naaf.conf disagrees with the settings table; the DB wins at runtime",
    key: d[:key], conf: d[:conf], db: d[:db])
end

WEB_PORT = Naaf::Config.int("NAAF_WEB_PORT")

# Two binds, never 0.0.0.0. The loopback bind exists so first-run setup works
# over `ssh -L 8080:127.0.0.1:8080 <vps>` before any tunnel exists.
WEB_BINDS = [
  "http://#{settings[:server_ip]}:#{WEB_PORT}",
  "http://127.0.0.1:#{WEB_PORT}"
].uniq

Async do |task|
  # Bring the kernel in line with the DB at boot. On the very first boot wg0 does
  # not exist yet (wg-quick@wg0 is ordered after us), so `wg syncconf` fails —
  # that is expected. Log and continue so the web/DNS servers still come up; the
  # 30s reconcile loop re-applies once wg0 exists.
  begin
    recon.apply!
  rescue => e
    Console.warn("naaf", "boot apply failed; will retry via reconcile loop", exception: e)
  end

  task.async do
    dns_port = Naaf::Config.int("NAAF_DNS_PORT")
    endpoint = Async::DNS::Endpoint.for(settings[:server_ip], port: dns_port)
    Console.info("naaf", "DNS listening", on: "#{settings[:server_ip]}:#{dns_port}")
    Naaf::DNSServer.new(
      zone: zone,
      # A callable, not a value: Zone#reload! refreshes it on every apply!, so
      # editing the upstream in the Settings UI takes effect on the next query
      # rather than the next restart.
      upstream: -> { zone.upstream },
      endpoint: endpoint
    ).run
  end

  app = Rack::Builder.parse_file(File.expand_path("../config.ru", __dir__))
  app = app.first if app.is_a?(Array)   # Rack 2 returns [app, opts]
  # cache: false is load-bearing. Falcon defaults it to true, which installs
  # Async::HTTP::Cache::General — a *shared* cache that looks up the store
  # before it checks whether the request is cacheable, so it ignores the
  # session cookie on the way in. A logged-out GET / returns 302 -> /login with
  # no Set-Cookie, which it happily stores (302 is cacheable) and then replays
  # to authenticated users forever, since the entry carries no max-age. That is
  # a login loop on whichever URL you visited first. A single-admin control
  # plane has no use for a shared cache; the app also sends Cache-Control:
  # no-store, but do not rely on that alone.
  middleware = Falcon::Server.middleware(app, cache: false)

  WEB_BINDS.each do |bind|
    task.async do
      endpoint = Async::HTTP::Endpoint.parse(bind)
      Console.info("naaf", "web listening", on: bind)
      Falcon::Server.new(middleware, endpoint).run
    end
  end

  task.async do
    interval = Naaf::Config.int("NAAF_RECONCILE_INTERVAL")
    loop do
      sleep interval
      begin
        recon.poll!
      rescue => e
        Console.error("naaf", "reconcile failed", exception: e)
      end
    end
  end
end
