#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== Standard =="; bundle exec standardrb

echo "== Tests ==";    bundle exec sus

echo "== nft render check =="
# Render against a throwaway DB so the check never depends on /var/lib/wgcp.
tmpdb="$(mktemp -d)/ci.db"
WGCP_DB="$tmpdb" bundle exec ruby -e '
  $LOAD_PATH.unshift("lib"); require "wgcp/db"; require "wgcp/renderers/nftables"
  File.write("/tmp/ci.nft", WGCP::Renderers::Nftables.render(WGCP.db))
'
if command -v nft >/dev/null 2>&1; then
  nft -c -f /tmp/ci.nft 2>/dev/null && echo "nft check passed" \
    || echo "(nft check skipped — needs root/nftables)"
else
  echo "(nft check skipped — nft not installed on this host)"
fi
