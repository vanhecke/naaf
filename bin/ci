#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== Standard =="; bundle exec standardrb

echo "== Tests ==";    bundle exec sus

echo "== shellcheck =="
# The deploy scripts are a real part of this project — two config-install bugs
# shipped in them before a live deploy caught them — so lint them like code.
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -S warning bin/ci deploy.sh deploy/*.sh deploy/provision/*.sh deploy/providers/*/*.sh
  echo "shellcheck clean"
else
  echo "(skipped — shellcheck not installed)"
fi

echo "== naaf.conf.example =="
# naaf.conf is read three ways: systemd EnvironmentFile=, `set -a; . file`, and
# lib/naaf/config.rb. test/config_test.rb pins the systemd grammar and the key
# parity with Config::DEFAULTS; this proves the shell half, which has no other
# cheap check. The subshell keeps the sourced variables out of this script.
( set -a; . ./naaf.conf.example; set +a ) && echo "sourceable by /bin/sh"

# bin/naaf-helper runs as root and loads lib/naaf/config.rb via require_relative.
# Keeping that file require-free is what stops the privileged process growing a
# gem surface, so enforce it here rather than trusting a comment.
if grep -nE '^[[:space:]]*require' lib/naaf/config.rb; then
  echo "lib/naaf/config.rb must stay require-free — bin/naaf-helper loads it as root" >&2
  exit 1
fi
echo "config.rb is require-free"

echo "== vendored assets =="
# The two scripts in vendor/ are the only client-side JavaScript that ships, and
# they arrive by download rather than through a lockfile. Pin them by digest so
# a swapped or truncated file fails the build instead of the browser.
#   htmx.min.js         htmx 2.0.10
#   htmx-ext-sse.min.js htmx-ext-sse 2.2.4 (0BSD)
check_digest() {
  want="$2"
  got="$(openssl dgst -sha384 -binary "$1" | openssl base64 -A)"
  if [ "$got" != "$want" ]; then
    echo "$1 has an unexpected sha384" >&2
    echo "  expected $want" >&2
    echo "  actual   $got" >&2
    exit 1
  fi
}
check_digest vendor/htmx.min.js \
  "H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
check_digest vendor/htmx-ext-sse.min.js \
  "A986SAtodyH8eg8x8irJnYUk7i9inVQqYigD6qZ9evobksGNIXfeFvDwLSHcp31N"
echo "vendored scripts match their pinned digests"

echo "== nft render check =="
# Render against a throwaway DB so the check never depends on /var/lib/naaf, and
# keep the output in the same temp dir so concurrent runs cannot collide.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
NAAF_DB="$tmpdir/ci.db" NAAF_CONF=/dev/null CI_NFT="$tmpdir/ci.nft" bundle exec ruby -e '
  $LOAD_PATH.unshift("lib"); require "naaf/db"; require "naaf/renderers/nftables"
  File.write(ENV.fetch("CI_NFT"), Naaf::Renderers::Nftables.render(Naaf.db))
'
if command -v nft >/dev/null 2>&1; then
  nft -c -f "$tmpdir/ci.nft" 2>/dev/null && echo "nft check passed" \
    || echo "(nft check skipped — needs root/nftables)"

  # The base firewall ships as a template now, rendered at provisioning time.
  # A syntax error there locks you out of the box, so check it here too.
  sed -e 's#__NAAF_LISTEN_PORT__#51820#g' -e 's#__NAAF_WG_INTERFACE__#wg0#g' \
    deploy/nftables.conf.template >"$tmpdir/base.nft"
  nft -c -f "$tmpdir/base.nft" 2>/dev/null && echo "base firewall template check passed" \
    || echo "(base firewall template check skipped — needs root/nftables)"
else
  echo "(nft checks skipped — nft not installed on this host)"
fi
