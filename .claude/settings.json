{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'f=$(jq -r \".tool_input.file_path // empty\"); cd \"$CLAUDE_PROJECT_DIR\" || exit 0; case \"$f\" in *.rb) bundle exec standardrb --fix \"$f\" >/dev/null 2>&1 ;; esac; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'echo \"--- git status ---\"; git -C \"$CLAUDE_PROJECT_DIR\" status --short --branch'"
          }
        ]
      }
    ]
  }
}
